{% extends '@layouts/base.twig' %}

{% block body %}
  <div class="container">
    <div data-component="Syh" data-option-collection="auro-concept-live" class="flex max-w-full">
      <div data-ref="colG" class="flex-1">
        {# Ratio fixe indépendant de la hauteur du panneau de droite (qui varie selon l'étape) — #}
        {# référentiel commun aux calques, voir docs/module-6-rendu-live.md. À ajuster une fois   #}
        {# le ratio réel des visuels connu (placeholder 3:4 pour l'instant).                      #}
        <div id="renderedImage" class="w-full aspect-[3/4] sticky top-20"></div>
      </div>
      <div class=" text-black flex-1 max-w-full">
        {# Récapitulatif persistant de la sélection courante #}
        <div data-ref="recap" class=" max-w-full flex lg:overflow-auto overflow-scroll items-start lg:flex-wrap lg:items-center gap-x-6 gap-y-1 px-6 py-3 bg-gray-50 border-b text-sm min-h-10"></div>

        {# Stepper — boutons générés dynamiquement par JS #}
        <nav data-ref="stepper" class="flex overflow-auto max-w-full lg:flex-wrap gap-4 py-4 px-6 border-b"></nav>

        {# Zone de l'étape courante — réécrite à chaque step #}
        <div data-ref="stepContent" class="container py-8"></div>

        {# Prix total #}
        <div data-ref="totalPrice" class="container py-4 font-medium"></div>

        {# ------------------------------------------------------------------ #}
        {# Templates HTML clonés par le JS selon field.type                   #}
        {# Les classes Tailwind ci-dessous sont provisoires — à remplacer     #}
        {# par ton markup pixel-perfect. Le contrat data-* est obligatoire.   #}
        {# ------------------------------------------------------------------ #}

        {# ------------------------------------------------------------------ #}
        {# Template RadioField                                               #}
        {# Le JS clone ce template, remplit les data-ref, n'écrit jamais    #}
        {# de HTML. Personnalise librement les classes Tailwind ici.        #}
        {# ------------------------------------------------------------------ #}
        <template data-template="radio">
          <div data-component="RadioField" class="mb-6">
            <fieldset class="border-0 p-0 m-0">
              <legend data-ref="label" class="block text-sm font-medium uppercase mb-3"></legend>
              <div data-ref="options" class="flex overflow-auto lg:flex-wrap gap-3 p-1"></div>
            </fieldset>

            {# Template d'une option : label seul #}
            <template data-template="radio-option--label">
              <label class="flex items-center cursor-pointer  px-4 py-2 rounded ring-1 has-[:checked]:ring-2 has-[:checked]:ring-purple/80 ring-purple/20">
                <input data-ref="input" type="radio" class="sr-only" />
                <span data-ref="optLabel"></span>
              </label>
            </template>

            {# Template d'une option : label + image (photo produit, opt.image) #}
            <template data-template="radio-option--label_image">
              <label class="flex flex-col aspect-square shrink-0 lg:aspect-auto justify-center items-center gap-2 cursor-pointer  px-4 py-3 rounded ring-1 has-[:checked]:ring-2 has-[:checked]:ring-purple/80 ring-purple/20">
                <input data-ref="input" type="radio" class="sr-only" />
                <img data-ref="image" alt="" class=" w-44 mix-blend-multiply h-auto object-contain" />
                <span data-ref="optLabel"></span>
              </label>
            </template>

            {# Template d'une option : label + vignette coloris (collection.coloris[].thumbnail) #}
            {# Réservé au champ `coloris` — voir docs/json-schema-reference.md.                  #}
            <template data-template="radio-option--label_thumbnail">
              <label class="flex items-center gap-2 cursor-pointer  px-4 py-2 rounded ring-1 has-[:checked]:ring-2 has-[:checked]:ring-purple/80 ring-purple/20">
                <input data-ref="input" type="radio" class="sr-only" />
                <img data-ref="image" alt="" class="w-6 h-6 rounded-full object-cover shrink-0" />
                <span data-ref="optLabel"></span>
              </label>
            </template>
          </div>
        </template>

        {# ------------------------------------------------------------------ #}
        {# Template LengthField                                              #}
        {# ------------------------------------------------------------------ #}
        <template data-template="length">
          <div data-component="LengthField" class="mb-6">
            <fieldset class="border-0 p-0 m-0">
              <legend data-ref="label" class="block text-sm font-medium uppercase mb-3"></legend>
              <div class="flex flex-wrap items-center gap-3">
                <div data-ref="presets" class="flex overflow-auto lg:flex-wrap gap-3 p-1"></div>

                {# Ouvre la modale de calcul de longueur (panel #extra, clé calcul-longueur). #}
                {# Déclenchement géré directement par LengthField (onCalcButtonClick) — pas   #}
                {# de data-component="Action" ici, ce bouton est injecté dynamiquement et ne   #}
                {# serait pas garanti d'être découvert par l'arbre de composants de l'App.     #}
                <button
                  type="button"
                  data-ref="calcButton"
                  class="px-4 py-2 rounded ring-1 ring-purple/40 text-sm underline underline-offset-2"
                >
                  Calcul de longueur
                </button>
              </div>
            </fieldset>

            {# Template d'un bouton preset standard #}
            <template data-template="length-preset">
              <button type="button" class="px-4 py-2 rounded ring-1 [&.is-active]:ring-2 [&.is-active]:ring-purple/80 ring-purple/20"></button>
            </template>

            {# Template du bouton sur-mesure — l'input est intégré et caché par défaut #}
            <template data-template="length-custom">
              <button type="button" data-value="custom" class="flex items-center gap-2 px-4 py-2 rounded ring-1 [&.is-active]:ring-2 [&.is-active]:ring-purple/80 ring-purple/20">
                <span>Sur-mesure</span>
                <input
                  type="number"
                  class="hidden w-20 bg-transparent border-b border-current outline-none text-sm"
                  placeholder="cm"
                />
              </button>
            </template>
          </div>
        </template>

        {# ------------------------------------------------------------------ #}
        {# Template ProductField — grille de toutes les options visibles   #}
        {# ------------------------------------------------------------------ #}
        <template data-template="product">
          <div data-component="ProductField" class="mb-6">
            <p data-ref="label" class="block text-sm font-medium uppercase mb-3"></p>

            {# Justification de la présélection automatique (option.defaultMessage, affiché  #}
            {# quand l'option sélectionnée a un defaultIf qui correspond) — masqué sinon.     #}
            <p data-ref="defaultMessage" class="text-sm text-gray-600 italic mb-3" hidden></p>

            {# Grille des cartes produit (générées dynamiquement) #}
            <div data-ref="cards" class="flex overflow-auto lg:flex-wrap gap-3 p-1"></div>

            {# Template d'une carte produit                                     #}
            {# label + radio : sélection accessible, pas de <button> imbriqué  #}
            <template data-template="product-card" >
              <label class="relative pb-16 flex flex-col gap-2 p-4 w-72 rounded ring-1 ring-purple/20 cursor-pointer has-[:checked]:ring-2 has-[:checked]:ring-purple/80">
                <input type="radio" class="sr-only" />
                <div class="w-full aspect-square bg-gray-50 rounded overflow-hidden">
                  <img data-ref="productImage" alt="" class="mix-blend-multiply w-full h-full object-contain" />
                </div>
                <span data-ref="productName" class="text-sm font-medium leading-tight"></span>
                <span data-ref="productRef" class="text-xs text-gray-400 font-mono"></span>
                <div class="flex items-center gap-1 text-sm">
                  <span data-ref="productPrice" class="font-medium"></span>
                  <span class="text-gray-400">×</span>
                  <span data-ref="productQty" class="text-gray-500"></span>
                </div>
                <span data-ref="productStock" class="text-xs"></span>
                <div data-ref="colorSwatches" class="flex flex-wrap gap-1.5 mt-1 absolute bottom-4 left-4 right-4"></div>
              </label>
            </template>

            {# Template d'un swatch coloris #}
            <template data-template="product-swatch">
              <button
                type="button"
                class="w-10 h-10 rounded-sm ring-1 ring-offset-1 ring-transparent [&.is-active]:ring-2 [&.is-active]:ring-purple/80 [&.is-active]:ring-offset-2"
                title=""
              ></button>
            </template>
          </div>
        </template>

      </div>
    </div>

  </div>

  {# Ouvre la modale "Changer de collection" (panel #extra, clé collections) — voir            #}
  {# modal-router.js. Le data-modal="collections" suffit : le clic global du router ouvre le   #}
  {# panel automatiquement, aucun wiring JS dédié à ce bouton.                                 #}
  {% include '@components/button.twig' with {
    label: 'Changer de collection',
    variant: 'solid',
    attr: {
      type: 'button',
      class: 'fixed bottom-4 right-4 z-40',
      'data-modal': 'collections'
    }
  } only %}

  {% include '@pages/configurateur-tringlerie/modal-configurateur.twig' %}
{% endblock %}
