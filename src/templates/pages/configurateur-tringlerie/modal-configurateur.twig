{# ------------------------------------------------------------------ #}
{# Modale : Sélection de couleur d'une pièce (renderMode live_colored) #}
{# Contenu cloné dans le panel #syh-couleur (tiroir venant de la       #}
{# droite, max-w-4xl) — voir l'embed en tête de fichier et             #}
{# color-modal.js. Voir docs/module-8b-modale-couleurs.md.            #}
{# ------------------------------------------------------------------ #}
<template data-modal="couleur" data-modal-title="Choisir une couleur">
  <div class="flex flex-col gap-4 divide-y divide-purple/20">
    {# Recherche : menu déroulant type Choices.js (pastille + libellé par ligne, champ de       #}
    {# recherche interne). Ne filtre PAS la grille ci-dessous — le nuancier reste toujours      #}
    {# entièrement visible. Peuplé et piloté par color-modal.js (instance Choices créée à la    #}
    {# main : le composant global ChoicesSelect n'est pas monté sur un contenu de modale cloné). #}
    <label class="flex flex-col m:flex-row m:items-center m:justify-between gap-4 text-xs s:text-sm leading-none font-medium uppercase text-purple">
      <span class="whitespace-nowrap">Chercher votre coloris</span>
      <div class="max-w-80">
        <select data-ref="search" data-search="true"></select>
      </div>
    </label>

    {# Dernières couleurs utilisées dans la config en cours (max 5, sans persistance) #}
    <div class="pt-4" data-ref="recentWrap" hidden>
      <p class="text-xs s:text-sm leading-none font-medium uppercase text-purple mb-4">Dernières couleurs utilisées</p>
      <div data-ref="recent" class="flex flex-wrap gap-2"></div>
    </div>

    {# Grille du nuancier complet — toujours affichée, jamais filtrée par la recherche #}
    <div class="pt-4">
      <p class="text-xs s:text-sm leading-none font-medium uppercase text-purple mb-4">Toutes les couleurs</p>
      <div data-ref="grid" class="grid grid-flow-col auto-rows-auto grid-rows-1 m:grid-rows-3 gap-2 m:flex m:flex-wrap overflow-x-auto -mx-4 px-4 l:px-px l:mx-0 py-px"></div>
    </div>

    {# Pastille clonée par color-modal.js (grille + récents). is-active porté par le <span>. #}
    <template data-template="color-modal-swatch">
      <button type="button" class="flex items-center justify-center p-0.5 focus:outline-none">
        <span class="size-6 rounded-full ring-1 ring-black/10 ring-offset-1 ring-offset-sand [&.is-active]:ring-2 [&.is-active]:ring-purple"></span>
      </button>
    </template>
  </div>

