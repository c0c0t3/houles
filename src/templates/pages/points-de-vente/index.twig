{% block body %}
<main>
  <section data-component="StoreLocator" data-pin-retailer="/assets/showroom-marker.png" data-pin-store="/assets/houles-marker.png" class="overflow-hidden m:flex m:items-end relative s:-mt-36 m:-mt-[7.125rem] m:bg-sand-darker m:pt-52 m:h-screen">
    <div id="map" data-ref="container" class="map w-full bg-gray/10 s:aspect-[4/3] m:aspect-auto m:absolute m:top-0 m:left-0 h-96 s:h-auto m:w-full m:h-full">
    </div>
    <div class="container m:relative">
      <div class="flex items-start justify-end m:absolute m:bottom-0 m:right-8">

        {# Back #}
        <div class="absolute top-4 m:top-0 m:right-full">
          <button data-ref="back" class="p-4 bg-purple-light opacity-0 pointer-events-none transition-all is-active:opacity-100 is-active:pointer-events-auto">
            {% include '@ui/Icon/Icon.twig' with {
              name: 'chevron',
              attr: {
                class: 'block size-4 rotate-90 text-white [&>svg]:w-full [&>svg]:h-full'
              }
            } %}
          </button>
        </div>

        {# Stores list #}
        <div data-ref="StoreLocatorNav" class="m:h-[calc(100svh-12rem)] flex flex-col w-full m:w-[512px] l:w-[655px] bg-sand pt-4 m:pt-8">
          <h2 class="m:px-8 font-serif text-2xl m:text-4xl uppercase leading-none text-gray mb-6">
            Points de vente
          </h2>


            {# TABS START#}

            <div class="relative overflow-hidden flex-1">
              {% embed '@ui/Tabs/Tabs.twig'
                with {
                  attr: {
                    data_component: 'Tabs Action',
                    data_option_on: 'enable',
                    data_option_effect: 'window.dispatchEvent(new Event("resize"))',
                    data_option_styles: {
                      btn: {
                        open: 'is-active'
                      }
                    },
                    class: 'h-full'
                  },
                  content_attr: {
                    class: 'flex flex-col h-full'
                  },
                  btn_attr: {
                    style: null,
                    data_component: 'Action',
                    data_option_target: 'StoreLocator',
                    data_option_effect: 'action.$el.querySelector(".b2b") ? target.displayMarkers("b2b") : target.displayMarkers("b2c")',
                    class: 'block p-2 group/btn text-sm uppercase text-purple-extra-light [&.is-active]:text-purple hover:text-purple-light transition-colors duration-300 ease-out-quad'
                  },
                  items: [
                    {
                      title: 'Professionnels',
                      description: 'Livraison transitaire',
                      key: 'b2b'
                    },
                    {
                      title: 'Particuliers',
                      description: 'Livraison directe à domicile',
                      key: 'b2c',
                      attr: {
                        data_option_is_open: true
                      }
                    }
                  ]
                }
              %}
                {% block title_wrapper %}
                  <div class="m:px-8 relative">
                    <div class="zdzdzd flex items-center justify-end w-full mb-6">
                      <span class="text-brown whitespace-nowrap shrink-0 uppercase font-medium text-sm">vous êtes</span>
                      <div class="w-full flex items-center justify-end ">{{ parent() }}</div>
                    </div>
                  </div>
                {% endblock %}
                {% block title %}
                  <span class="{{ item.key }} underline-effect-off group-[&.is-active]/btn:underline-effect-on">
                    {{ item.title }}
                  </span>
                {% endblock %}
                {% block content %}

                    {% if item.key == 'b2c' %}
                      {% include '@components/ui/distributors/b2c.twig' with b2c %}
                    {% elseif item.key == 'b2b' %}
                      {% include '@components/ui/distributors/b2b.twig' with b2b %}
                    {% endif %}
                {% endblock %}
              {% endembed %}
            </div>

            {# TABS END #}

        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
