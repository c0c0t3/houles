{% block body %}
  <main>
    <section class="m:mt-10 m:mb-14">
      <div class="s:container">
        <div class="m:grid m:grid-cols-2 m:gap-x-8">
          {# Product images #}
          {% include '@components/ui/shop/product-images-svp.twig' with {'product_code': product_infos.product_code, 'project_id': product_infos.project_id, 'zones': product_infos.zones, 'width': product_infos.width, 'height': product_infos.height} %}

          {# Product info #}
          {% include '@components/ui/shop/product-info-svp.twig' with product_infos %}
        </div>
      </div>
    </section>

    {# Related products #}
    {% include '@components/slider-product-2cols.twig' with related_products %}

    {# Collection infos #}
    {% include '@components/ui/shop/product-collection-infos.twig' with product_infos.collection_infos %}

    {# Collection Mood #}
    {% embed '@components/slider-mood-collection.twig'
      with {
        title: 'La collection en images ',
        attr: {
          class: 'py-10 m:py-28'
        }
      }
    %}
      {% block description %}
        <p class="text-base m:col-start-9 m:col-span-4">
          {{ product_infos.collection_infos.description }}
        </p>
      {% endblock %}
    {% endembed %}

    {# Product Mood #}
    {% include '@components/bloc-product-mood.twig' with product_mood %}

    {# Related products #}
    {% include '@components/slider-product-1col.twig' with related_products %}

    {# Crosssel tooltips #}
    {% include '@components/ui/shop/product-crosssel-tooltips.twig' with crosssel_tooltips %}

    {# Sticky add to cart #}
    {% include '@components/ui/shop/sticky-add-to-cart.twig' with product_infos %}
  </main>
{% endblock %}
