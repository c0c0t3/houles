{% block header %}

{% endblock %}

{% block body %}
  <main>
    {# HERO #}
    <section class="collection-hero mb-10 m:mb-24 xxl:max-w-screen-xxl xxl:mx-auto s:-mt-[9.5rem] m:relative">
      <div class="container">
        <div class="grid m:grid-cols-2 gap-4">
          {# Col Right / Media #}
          <div class="collection-hero__media m:order-last col-span-1 aspect-square xs:aspect-video m:aspect-auto ">
            {% include '@ui/FigureVideo/FigureVideo.twig' with {
              src: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4',
              poster: '/assets/shooroom.jpg',
              width: 640,
              height: 360,
              absolute: true,
              fit: 'cover',
              attr: {
                data_option_enter_from: 'opacity-0',
                data_option_enter_active: 'transition duration-500',
                class: 'relative m:absolute m:right-0 m:top-0 m:bottom-0 m:left-1/2'
              },
              inner_attr: {
                class: 'w-full '
              },
              img_attr: {
                class: 'opacity-0'
              }
            } only %}

            <div class="absolute right-6 bottom-6 z-50">
              {% embed '@components/modal/Panel.twig'
                with {
                  position: 'top',
                  overlay_attr: {
                    class: 'z-50 bg-black/20 absolute inset-0'
                  },
                  wrapper_attr: {
                    class: 'p-4 m:p-6 z-50 items-center '
                  },
                  container_attr: {
                    class: 'w-full max-w-2xl rounded bg-white'
                  }
                }
              %}
                {% block open %}
                  {% include '@components/button.twig' with {
                    label: 'Sauvegarder',
                    variant: 'outline',
                    icon: 'download',
                    attr: {
                      data_ref: 'open[]',
                      type: 'button',
                      class: 'product-info-add-to-cart-button w-full col-span-4 order-last l:order-2 l:col-span-5 !bg-white'
                    }
                  } only %}
                {% endblock %}
                {% block close %}
                  <div class="flex justify-end px-6 pt-6">
                    {% include '@ui/Button/Button.twig' with {
                      label: 'Fermer',
                      attr: {
                        data_ref: 'close[]'
                      }
                    } %}
                  </div>
                {% endblock %}
                {% block content %}
                  <div class="relative aspect-video w-full [&_iframe]:w-full [&_iframe]:h-full [&_iframe]:absolute [&_iframe]:top-0 [&_iframe]:left-0">
                    <iframe class="aspect-video w-full"
                      width="560"
                      height="315"
                      src="https://www.youtube-nocookie.com/embed/DXQgkA4Uje0"
                      title="YouTube video player"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen></iframe>
                  </div>
                {% endblock %}
              {% endembed %}
            </div>
          </div>

          {# Col Left / Content #}
          <div class="collection-hero__content order-2 col-span-1 text-center w-full m:max-w-lg mx-auto flex flex-col items-center justify-center px-4 m:px-0 gap-12 m:mt-56 m:mb-44">
            <div class="space-y-4">
              <span class="inline-block rounded bg-brown-light text-purple uppercase text-xs font-medium p-2">
                Nouvelle collection
              </span>
              <h1 class="font-serif text-2xl m:text-5xl uppercase leading-none text-gray w-full">
                Double corde & Galons doubles cordre & brains
              </h1>
              <p class="text-xs text-brown uppercase font-medium tracking-wider leading-none">
                1110 produits
              </p>
            </div>
            <div class="h-px w-full bg-brown/20"></div>
            <p>
              Maintenant disponible en OUTDOOR !
Créez vos propres passementeries parmi notre sélection d’articles (embrasses, galons, franges…) et de matières : Fibranne, Rayonne, Lin (37 articles) ou Outdoor (21 articles).
            </p>
            <div class="flex flex-col s:flex-row gap-6 items-center justify-center">
              {% include '@components/button.twig' with {
                label: 'Télécharger le catalogue',
                variant: 'link',
                invert: false,
                icon: 'download',
                attr: {
                  type: 'submit'
                }
              } only %}
              <div class="hidden m:block h-8 w-px bg-brown/20"></div>
              {% include '@components/button.twig' with {
                label: 'Télécharger le dépliant',
                variant: 'link',
                invert: false,
                icon: 'download',
                attr: {
                  type: 'submit'
                }
              } only %}
            </div>
          </div>
        </div>
      </div>
    </section>

    {# Collection Mood #}
    {% include '@components/slider-mood-collection.twig' %}

    {# LISTING PRODUCTS #}
    <section class="my-8 m:my-20">
      <div class="container">
        <h2 class="font-serif text-3xl s:text-4xl m:text-6xl uppercase leading-xtight mb-10 m:mb-14">
          Galons
        </h2>
        <div class="search-results grid grid-cols-2 s:grid-cols-3 m:grid-cols-4 gap-4 m:gap-8">
          {% for product in products %}
            {% embed '@components/ui/card/card-svp.twig' with product|merge({
              attr: {
                class: 'cardsvp',
                data_component: 'Action',
                data_option_target: 'Panel(#' ~ product.id ~ ')',
                data_option_effect: 'target.open()'
              }
            }) %}
            {% endembed %}
          {% endfor %}
        </div>
      </div>
    </section>

    {# ABOUT COLLECTION #}
    <section class="m:mb-16">
      <div class="container">
        <div class="grid grid-cols-1 m:grid-cols-12 gap-4 mb-10 m:mb-16">
          <h2 class="font-serif text-3xl s:text-4xl m:text-6xl uppercase leading-xtight m:col-span-4">
            À propos de la collection
          </h2>
          <div class="m:col-span-5 m:col-start-8 text-base">
            Pretium integer faucibus sed aliquet aliquam tincidunt. Sit urna cras non a pharetra ac.
            Arcu nisl urna amet placerat augue eget non nibh. Massa ultrices ac enim risus aenean
            mauris urna. Accumsan faucibus libero tortor facilisis placerat quisque faucibus tellus.
            Lobortis dapibus mattis tincidunt condimentum sit turpis morbi et ut. Elit sit purus
            ullamcorper sollicitudin. Pretium proin nascetur gravida nulla vitae quis odio nulla. Ut
            eget lorem feugiat morbi sit. Amet nisi netus arcu cursus nunc.
          </div>
        </div>
        <div class="h-px w-full bg-gradient-to-r from-gray to-transparent"></div>
      </div>
    </section>
  </main>
{% endblock %}
