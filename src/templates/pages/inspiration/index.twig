{% block body %}
  <main>
    {# Page Hero #}
    {% include '@components/page-hero.twig' with pagehero %}



    <section class="pb-80" data-component="InspirationGrid">
      <div class="container">



      {# Filtres à facettes #}
      {% include '@pages/inspiration/filters.twig' with {
        class: 'my-10 m:my-14'
      } %}



        <div data-ref="TheGrid" class="grid-masonry">
          

          <div class="grid-sizer"></div>
          {% for inspiration in items %}
            <div data-component="Action"
              data-option-target="Panel(#inspirationModal)"
              data-option-effect="target.open()"
              data-ref="InspirationGridItem[]" 
              data-id={{ loop.index }}
              class="grid-item {{ inspiration.filters }}"
              data-name="{{ inspiration.name }}"
              data-price="{{ inspiration.price }}" data-boom="{{ inspiration.filters }} ">
                <img data-option-target="InspirationSlider" data-option-effect="target.goToFilteredIndex()" data-component="Action" class="w-full" src="{{inspiration.image_main}}" alt="" height="{{inspiration.height}}" width="{{inspiration.width}}" data-hauteur="{{inspiration.height}}">
            </div>
          {% endfor %}
        </div>

      </div>
    </section>

    

    {% embed '@components/modal/Panel.twig'
      with {
        position: 'right',
        overlay_attr: {
          class: 'z-50 bg-black/20 absolute inset-0'
        },
        wrapper_attr: {
          class: 'p-0 z-50 items-center h-screen'
        },
        container_attr: {
          class: 'w-full max-w-full h-screen rounded bg-sand'
        },
        content_attr: {
          class: 'px-4 l:px-6 h-svh overflow-hidden',
        },
        attr: {
          id: 'inspirationModal',
        }
      }
    %}
      {% block open %}
      {% endblock %}
      {% block close %}
      {% endblock %}
      {% block content %}

            <div class=" hidden l:flex justify-between absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex-col uppercase text-4xl l:text-8xl text-transparent font-outline-1 font-serif leading-none w-[855px] max-w-full">
              <span>Le carnet</span>
              <span class="self-end">d'inspiration</span>
            </div>

            <div class="absolute top-4 right-4 l:top-6 l:right-6 z-50">
              {% include '@components/modal/close-modal-button.twig' with {
                attr: {
                  data_ref: 'close[]',
                  type: 'button'
                }
              } only %}
            </div>
          <div data-ref="InspirationSlider" data-component="InspirationSlider" class=" max-w-full h-svh flex flex-col items-between ">
            
            {# Main Slider #}
            <div data-ref="mainSlider" class="swiper-container main-slider relative z-10 flex-1 ">

              {# Swiper Wrapper #}
              <div class="swiper-wrapper">

                {# Slides in loop #}
                {% for slideinspi in items %}
                  <div data-component="InspirationSlide" data-id={{ loop.index }} data-index="{{loop.index}}" 
                    class="{{ slideinspi.filters }} h-full l:h-auto main-slide swiper-slide pointer-events-none transition-opacity duration-1000 !opacity-0 flex flex-col items-end l:items-center l:justify-start l:pt-6"
                    data-name="{{ slideinspi.name }}"
                    data-price="{{ slideinspi.price }}">
                    
                      {# Color Palette #}
                      <div data-ref="colorPalette"></div>

                      {# Slide name MOBILE #}
                      <div class="block l:hidden w-full pt-4 mb-8">
                        <div class="flex items-center relative gap-2">

                          {# Inspiration Type #}
                          <span class="inline-block text-xs uppercase font-medium text-purple rounded bg-brown-light px-2 py-1">{{ slideinspi.type }}</span>
                          
                          {# Inspiration wishlist trigger #}
                          <button data-ref="open[]"
                            data-component="Action"
                            data-option-target="Panel(#wishlist)"
                            data-option-effect="target.open()"
                            class=" flex items-center justify-center text-purple">
                            {% include '@ui/Icon/Icon.twig' with {
                              name: 'icon-heart',
                              attr: {
                                class: 'w-5 *:size-full'
                              }
                            } %}
                          </button>

                        </div>
                        <h2 class="mt-1 font-serif text-xl m:text-2xl uppercase leading-none text-gray">{{ slideinspi.name }}</h2>
                      </div>
                    
                    <div data-ref="tooltipContainer[]" class="relative  w-[calc(100%-40px)] l:w-full  flex justify-center l:justify-center ">
                      <img data-ref="image" class=" w-auto max-h-[calc(80vh-140px-48px)] l:max-h-[calc(100vh-140px-120px)] " src="{{slideinspi.image_main}}" alt="" width="400" data-hauteur="{{slideinspi.height}}">
                      {% if slideinspi.tooltips %}
                        {% set orientation = slideinspi.width >= slideinspi.height ? 'h-full' : 'h-full' %}
                        <div data-ref="tooltipContainer" style="--width: {{ slideinspi.width }}; --height: {{ slideinspi.height }};" class="tooltipContainer z-50 {{ orientation}}  max-h-[calc(80vh-140px-48px)] l:max-h-[calc(100vh-140px-48px)] m:block absolute l:top-0 l:right-0 l:left-1/2 l:-translate-x-1/2   [aspect-ratio:var(--width)_/_var(--height)] opacity-0 pointer-events-none">
                          {% for tooltip in slideinspi.tooltips %}
                            {% embed '@components/ui/tooltip.twig'
                              with {
                                tooltip_attributes: {
                                  class: 'z-10'
                                },
                                left: tooltip.left ~ '%',
                                top: tooltip.top ~ '%',
                                href: tooltip.href
                              }
                            %}
                              {% block content %}
                                <a href="{{ tooltip.href }}"
                                  class="flex items-stretch ring-1 ring-gray/10 bg-white opacity-0 pointer-events-none translate-y-8 transition-all duration-500 ease-out-quad group-aria-expanded:translate-y-0 group-aria-expanded:opacity-100 group-aria-expanded:pointer-events-auto pl-[120px] m:pl-[196px]">
                                  <div class="bg-sand-darker w-[120px] m:w-full h-full m:w-[196px] flex justify-center items-center absolute left-0 top-0">
                                    {% include '@ui/Figure/Figure.twig' with {
                                      src: tooltip.image,
                                      width: tooltip.image_width,
                                      height: tooltip.image_height,
                                      absolute: true,
                                      attr: {
                                        class: 'size-full'
                                      },
                                      inner_attr: {
                                        class: '!h-full'
                                      },
                                      img_attr: {
                                        class: 'mix-blend-multiply size-full object-contain'
                                      }
                                    } %}
                                    {% if tooltip.tag %}
                                      <span class="inline-block text-xs uppercase font-medium text-purple rounded bg-brown-light px-2 py-1 absolute top-4 left-4">
                                        {{ tooltip.tag }}
                                      </span>
                                    {% endif %}
                                  </div>
                                  <div class="w-48 flex flex-col gap-4 items-center justify-center text-center py-6 px-4">
                                    {% if tooltip.filters %}
                                      <span class="post-filters tracking-[0.15em] text-brown uppercase block font-sans text-xs font-medium whitespace-normal">
                                        {{ tooltip.filters }}
                                      </span>
                                    {% endif %}
                                    {% if tooltip.title %}
                                      <span class="text-lg m:text-3xl font-serif uppercase text-gray leading-none whitespace-normal">
                                        {{ tooltip.title }}
                                      </span>
                                    {% endif %}
                                    {% if tooltip.price %}
                                      <span class="block tracking-[0.15em] uppercase text-gray font-sans text-sm font-medium">
                                        {{ tooltip.price }}€ HT
                                      </span>
                                    {% endif %}
                                  </div>
                                </a>
                              {% endblock %}
                            {% endembed %}
                          {% endfor %}
                        </div>
                      {% endif %}
                      
                    </div>

                    {# Tooltips wrapper #}

                    {# Slider Infos #}
                    <div class="flex flex-col l:flex-row justify-end py-4 l:py-8 items-center w-full shrink-0 absolute bottom-8 l:bottom-0 gap-4">

                      {# Slide name desktop #}
                      <div class="l:flex-1 hidden l:block l:pl-8">
                        <div class="flex items-center relative gap-2 ">

                          {# Inspiration Type #}
                          <span class="inline-block text-xs uppercase font-medium text-purple rounded bg-brown-light px-2 py-1">{{ slideinspi.type }}</span>
                          
                          {# Inspiration wishlist trigger #}
                          <button data-ref="open[]"
                            data-component="Action"
                            data-option-target="Panel(#wishlist)"
                            data-option-effect="target.open()"
                            class=" flex items-center justify-center text-purple">
                            {% include '@ui/Icon/Icon.twig' with {
                              name: 'icon-heart',
                              attr: {
                                class: 'w-5 *:size-full'
                              }
                            } %}
                          </button>

                        </div>
                        <h2 class="mt-1 font-serif text-xl m:text-2xl uppercase leading-none text-gray">{{ slideinspi.name }}</h2>
                      </div>

                      {# Slide image download #}
                      <div class="l:flex-1 flex justify-center">
                        {% include '@components/button.twig' with {
                          label: 'Telechargez le visuel',
                          variant: 'link',
                          invert: false,
                          href: slideinspi.main_image,
                          icon: 'download',
                          size: 'small',
                          attr: {
                            class: 'w-auto'
                          }
                        } only %}
                      </div>

                      {# Slider tooltip trigger #}
                      <div class="l:flex-1 flex justify-end text-">
                        {% if slideinspi.tooltips %}
                          {% include '@components/field-toggle.twig' with {
                            attr: {
                              class: 'toggleTooltipButton mt-2',
                              data_ref: 'toggleTooltipButton',
                            },
                            label: 'Aficher les produits',
                            labelClass: '!uppercase font-medium !text-sm',
                            name: 'use_credit'
                          } only %}
                        {% endif %}
                        
                        {% if slideinspi.product_url %}
                          {% include '@components/button.twig' with {
                            label: 'Voir le produit',
                            variant: 'solid',
                            icon: 'add-to-cart',
                            href: slideinspi.product_url,
                            size: 'small',
                            attr: {
                              class: 'w-auto'
                            }
                          } only %}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endfor %}

              </div>

              <button title="Prev"
                type="button"
                class="main-swiper-button-prev  rounded cursor-pointer transition disabled:opacity-50 disabled:cursor-not-allowed text-purple hidden m:block absolute top-1/2 -translate-y-1/2 left-0 z-10 py-4">
                {% include '@ui/Icon/Icon.twig' with {
                  name: 'arrow-line-desktop',
                  attr: {
                    class: ['w-14', 'block', 'rotate-180']
                  }
                } %}
              </button>
              <button title="Next"
                type="button"
                class="main-swiper-button-next rounded cursor-pointer transition disabled:opacity-50 disabled:cursor-not-allowed text-purple hidden m:block absolute top-1/2 -translate-y-1/2 right-0 z-10 py-4">
                {% include '@ui/Icon/Icon.twig' with {
                  name: 'arrow-line-desktop',
                  attr: {
                    class: ['w-14', 'block']
                  }
                } %}
              </button>
            </div>
            
            {# Thumb #}
            <div data-ref="thumb-slider" class="swiper-container thumbs-slider shrink-0 cursor-grab pb-2 h-20">
              <div class="swiper-wrapper items-end">

                {% for thumbinspi in items %}
                  <div  
                    data-index="{{loop.index}}" 
                    data-id={{ loop.index }}
                    class="{{ thumbinspi.filters }} swiper-slide thumb-slide h-14 !w-14"
                    data-name="{{ thumbinspi.name }}"
                    data-price="{{ thumbinspi.price }}">
                    <img class="" src="{{thumbinspi.image_main}}" alt="" width="400" data-hauteur="{{thumbinspi.height}}">
                  </div>
                {% endfor %}

              </div>
            </div>
          </div>

          {% include '@components/modal/wishlist/wishlist.twig' %}
          {% include '@components/modal/wishlist/wishlist-new-list.twig' %}



      {% endblock %}
    {% endembed %}

    <div class="swiper-slide-pool hidden"></div>

  </main>
{% endblock %}

{% block body_after %}
  <section>
    <div class="container">
      <h2 class="text-3xl s:text-4xl m:text-6xl font-serif text-gray font-light uppercase mb-8 m:mb-14">
        Vous aimerez aussi
      </h2>
      <div class="grid grid-cols-2 gap-4 m:gap-6">
        {% for page in other_pages %}
          {% include '@components/ui/card/card-page.twig' with {
            title: page.title,
            filtersTitle: page.filtersTitle,
            src: page.src,
            link: page.link
          } %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endblock %}
