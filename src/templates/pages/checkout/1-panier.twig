{% set searchResults = [
  {
    id: 1,
    title: 'Gland de clé',
    img: '/assets/products/36249_9150_P3_1.jpg',
    code: '32051-9300',
    price: 16.2,
    quantity: 1
  },
  {
    id: 3,
    title: 'Auro - Configuration de tringlerie 180,00cm',
    img: '/assets/products/32031_9700_L3_1.jpg',
    code: '32052-9600',
    price: 234.34,
    quantity: 1
  },
  {
