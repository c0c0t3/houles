{% block content %}
  <form data-component="Cart" class="w-full relative flex items-center justify-between rounded-lg">
    {% include '@ui/Icon/Icon.twig' with {
      name: 'icon-search-',
      attr: {
        class: 'hidden m:block size-10 block shrink-0 [&>svg]:size-ful text-brown absolute left-3'
      }
    } only %}
    <input data-ref="searchCart"
      class="{{
      html_classes(
        [
          'flex-1 text-gray bg-sand-darker pl-4 pr-16 m:pl-16 m:pr-40 py-4 rounded-lg ',
          'focus:ring-2  focus:ring-brown focus:outline-none',
          'search-cancel:hidden'
        ]
      )
      }}"
      type="search"
      placeholder="Ajout rapide par référence ou nom d’article" />
    {% include '@components/modal/cart-quick-add.twig' with searchResults %}
  </form>

  <div class="space-y-6">
    {% include '@components/table/cart.twig' with {
      rows: cart_lines
    } only %}
    <div class="flex s:flex-row flex-col-reverse s:justify-between s:items-center gap-6 pt-6 border-t border-brown/20">
      {% include '@components/button.twig' with {
        label: 'Vider le panier',
        icon: 'cross',
        variant: 'link'
      } only %}
      <form action="" method="post" class="flex items-center gap-3">
        <input {{
          html_attributes({
            type: 'text',
            name: 'discount_code',
            placeholder: 'Ajouter un code promo',
            class: 'block w-full font-sans font-medium text-sm leading-6 ring-1 ring-inset rounded-lg bg-transparent text-purple ring-purple py-4 px-6 focus-visible:bg-white appearance-none'
          })
          }} />
        {% include '@components/button.twig' with {
          label: 'Ajouter',
          icon: false,
          variant: 'outline'
        } only %}
      </form>
    </div>
  </div>
  <div class="space-y-6">
    <h2 class="text-base font-sans font-medium leading-snug text-purple text-right">
      Total Panier
    </h2>
    {% include '@components/price-lines.twig' with {
      lines: [
        {
          label: 'Total Ht',
          value: 234.64
        },
        {
          label: 'TVA 20,00%',
          value: 46.93
        },
        {
          label: 'Total ttc',
          value: 281.57
        }
      ]
    } only %}
  </div>
  <div class="grid s:grid-cols-2 gap-4">
    {% include '@components/button.twig' with {
      label: 'Recevoir un devis',
      variant: 'outline'
    } only %}
    {% include '@components/button.twig' with {
      label: 'Commander',
      href: '/checkout/2-livraison.html'
    } only %}
  </div>
{% endblock %}
