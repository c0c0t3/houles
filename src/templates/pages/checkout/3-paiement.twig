  },
  {
    id: 3,
    title: 'Auro - Configuration de tringlerie 180,00cm',
    href: '#configuration-3',
    img: '/assets/espace-pro/produit-1.jpg',
    code: '32053-9600',
    status: {
      label: 'En stock',
      type: 'success'
    },
    price: 234.34,
    quantity: 1,
    options: [
      {
        id: 4,
