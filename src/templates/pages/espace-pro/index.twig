{% extends '@layouts/base.twig' %}

{% set body_attr = {
  class: 'grid grid-rows-[auto_1fr] min-h-[100svh]'
} %}

{% block body %}
  <div class="container flex flex-col items-center justify-center">
    <form action="" method="post" class="flex flex-col gap-8 py-8 w-full max-w-[22.5rem] mx-auto">
      <h1 class="text-4xl font-serif text-gray font-light uppercase text-center">Connexion</h1>
      <div class="flex flex-col gap-6">
        {% include '@components/field.twig' with {
          label: 'Mon adresse e-mail',
          name: 'email',
          type: 'email',
          required: true
        } only %}
        {% include '@components/field.twig' with {
          label: 'Mon mot de passe',
          name: 'password',
          type: 'password',
          required: true
        } only %}
        <div class="flex items-center">
          <input id="remember"
            type="checkbox"
            name="remember"
            class="size-4 rounded-none cursor-pointer accent-purple" />
          <label for="remember" class="font-medium text-gray cursor-pointer pl-2">
            Se souvenir de moi
          </label>
        </div>
        <div class="space-y-2">
          <a href="/espace-pro/activate/" class="block text-xs underline">
            Je n’ai pas reçu le mail pour activer mon compte
          </a>
          <a href="/espace-pro/mot-de-passe-oublie/" class="block text-xs underline">
            J'ai oublié mon mot de passe
          </a>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        {% include '@components/button.twig' with {
          label: 'Se connecter',
          variant: 'solid',
          attr: {
            type: 'submit'
          }
        } only %}
        {% include '@components/button.twig' with {
          label: 'Créer un compte',
          href: '/inscription/',
          icon: false,
          variant: 'outline'
        } only %}
        {% include '@components/button.twig' with {
          label: 'Première connexion',
          href: '/activation/',
          icon: false,
          variant: 'link'
        } only %}
      </div>
    </form>
  </div>
{% endblock %}

{% block footer_before %}{% endblock %}

{% block footer %}{% endblock %}
