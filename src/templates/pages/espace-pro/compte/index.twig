{% extends '@layouts/pro.twig' %}

{% set breadcrumb_items = [
  {
    label: 'Mon compte',
    url: '/espace-pro/compte/'
  }
] %}

{% set title = 'Mon compte' %}

{% set client_number = 'P7700222' %}

{% set addresses = [
  {
    type: 'billing',
    fullname: 'Andre Houles et Cie',
    line_1: '5 Avenue de la Marseillaise',
    line_2: null,
    zip: '67000',
    city: 'Strasbourg',
    country: 'France',
    is_default: true
  },
  {
    type: 'shipping',
    fullname: 'Andre Houles et Cie',
    line_1: '2 Chemin de la Coudrette',
    line_2: null,
    zip: '77123',
    city: 'Noisy-sur-École',
    country: 'France',
    is_default: true
  }
] %}

{% block title %}
  <div class="space-y-1">
    {{ parent() }}
    <p class="text-sm text-brown uppercase font-medium">
      N° de client&nbsp;: <span class="text-purple">{{ client_number }}</span>
    </p>
  </div>
{% endblock %}

{% block content %}
  <div class="grid grid-cols-1 s:grid-cols-2 m:grid-cols-3 gap-6 s:gap-8">
    {% for address in addresses %}
      <div class="bg-white text-gray p-6 s:p-8 space-y-6">
        <div>
          <h2 class="mb-3 text-base font-sans font-medium leading-snug text-purple">
            {{ address.type == 'billing'
              ? 'Mon adresse de facturation'
              : 'Mon adresse de livraison' }}
          </h2>
          <p class="text-2xl font-serif font-light uppercase leading-snug">
            {{ address.fullname }}
          </p>
        </div>
        <address class="not-italic uppercase">
          <p>
            {{ address.line_1 }}<br />
            {% if address.line_2 %}
              {{ address.line_2 }}<br />
            {% endif %}
            {{ address.zip }} {{ address.city }}<br />
            {{ address.country }}
          </p>
        </address>
      </div>
    {% endfor %}
    <div class="bg-purple text-white p-6 s:p-8 space-y-6 s:col-span-2 m:col-span-1">
      <div>
        <h2 class="mb-3 text-base font-sans font-medium leading-snug">Mon contact</h2>
        <p class="text-2xl font-serif font-light uppercase leading-snug">
          Service commercial France
        </p>
      </div>
      <div class="space-y-4">
        <p>Service commercial france</p>
        <p>Téléphone&nbsp;: <a href="tel:0160396200" class="hover:underline">01 60 39 62 00</a></p>
        <p>
          <a href="mailto:isabelle.bouhier@houles.com" class="hover:underline">
            isabelle.bouhier@houles.com
          </a>
        </p>
      </div>
    </div>
  </div>
  <div class="bg-white text-gray p-6 s:p-8 space-y-10">
    <h2 class="mb-3 text-base font-sans font-medium leading-snug text-purple">
      Mes dernières commandes
    </h2>
    {% include '@components/callout.twig' with {
      attr: {
        class: '!mt-3'
      },
      title: 'Vous avez 2 factures en attente de réglement',
      links: [
        {
          label: 'Régler la facture',
          href: '/factures/5625182'
        },
        {
          label: 'Toutes les factures en attente',
          href: '/espace-pro/compte/commandes-et-devis/'
        }
      ]
    } only %}
    {% include '@components/table/bills.twig' with {
      rows: [
        {
          id: '5625191',
          date: '2024-07-09',
          amount: 0,
          status: {
            label: 'Expédiée',
            type: 'success'
          },
          informations: 'SETS Galon coton'
        },
        {
          id: '5625183',
          date: '2023-11-29',
          amount: 147,
          status: {
            label: 'Commande annulée',
            type: 'error'
          },
          informations: null
        },
        {
          id: '5625182',
          date: '2022-02-03',
          amount: 0,
          status: {
            label: 'En attente de validation',
            type: 'warning'
          },
          informations: 'Projet_SVP'
        },
        {
          id: '5625191',
          date: '2024-07-09',
          amount: 0,
          status: {
            label: 'Expédiée',
            type: 'success'
          },
          informations: 'SETS Galon coton'
        }
      ]
    } only %}
  </div>
  <div class="bg-white text-gray p-6 s:p-8 space-y-10">
    <h2 class="mb-3 text-base font-sans font-medium leading-snug text-purple">
      Mes devis en cours
    </h2>
    {% include '@components/table/invoices.twig' with {
      rows: [
        {
          id: '5625191',
          date: '2025-04-09',
          amount: 275.4,
          informations: 'Projet'
        }
      ]
    } only %}
  </div>
{% endblock %}
