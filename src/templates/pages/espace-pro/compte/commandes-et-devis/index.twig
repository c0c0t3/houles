{% extends '@layouts/pro.twig' %}

{% set breadcrumb_items = [
  {
    label: 'Mon compte',
    url: '/espace-pro/compte/'
  },
  {
    label: 'Commandes & devis',
    url: '/espace-pro/compte/commandes-et-devis/'
  }
] %}

{% set title = 'Commandes & devis' %}

{% block title %}
  <div class="flex justify-between items-center flex-wrap gap-4 mb-3">
    {{ parent() }}
    <div class="flex items-center gap-2">
      {% include '@components/button.twig' with {
        label: 'Regler mes factures',
        href: '/espace-pro/compte/commandes-et-devis/regler-facture',
        type: 'solid'
      } %}
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="bg-white text-gray p-6 s:p-8 space-y-10">
    <h2 class="mb-3 text-base font-sans font-medium leading-snug text-purple">Mes commandes</h2>

    <form class="w-full relative flex items-center justify-between rounded-lg">
      {% include '@ui/Icon/Icon.twig' with {
        name: 'icon-search-',
        attr: {
          class: 'hidden m:block size-10 block shrink-0 [&>svg]:size-ful text-brown absolute left-3'
        }
      } only %}
      <input class="{{
        html_classes(
          [
            'flex-1 text-gray bg-sand-darker pl-4 pr-16 m:pl-16 m:pr-40 py-4 rounded-lg ',
            'focus:ring-2  focus:ring-brown focus:outline-none',
            'search-cancel:hidden'
          ]
        )
        }}"
        type="search"
        placeholder="Recherchez par numéro de commande / facture" />
      <button type="submit" class="btn !p-1.5 m:!px-6 m:!py-2.5 absolute right-2">
        <span class="text-sm uppercase font-medium hidden m:block">Rechercher</span>
        {% include '@ui/Icon/Icon.twig' with {
          name: 'icon-search-',
          attr: {
            class: 'size-8 m:size-10 block [&>svg]:size-full m:hidden'
          }
        } only %}
      </button>
    </form>

