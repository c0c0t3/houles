    src_height: 408,
    categoryTitle: 'Actualité'
  },
  {
    title: 'Houlès, un siècle d’histoire raconté dans notre livre',
    link: '/blog/article.html',
    src: '/assets/blog-2.jpg',
    src_width: 427,
    src_height: 528,
    categoryTitle: 'Actualité'
  },
  {
    title: 'Les passementeries Houlès à l’École Boulle',
    link: '/blog/article.html',
    src: '/assets/blog-3.jpg',
