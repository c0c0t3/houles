{% set categories = [
  {
    title: 'Passementerie',
    link: '/shop/categorie.html',
    src: '/assets/cat.jpg',
    nbrCollection: 12
  },
  {
    title: 'Tringlerie',
    link: '/shop/categorie.html',
    src: '/assets/cat2.jpg',
    nbrCollection: 24
  },
  {
    title: 'Tissu',
    link: '/shop/categorie.html',
    src: '/assets/cat3.jpg',
    nbrCollection: 12
  },
  {
    title: 'Fournitures',
    link: '/shop/categorie.html',
    src: '/assets/cat4.jpg',
    nbrCollection: 12
  },
  {
    title: 'Fin de séries',
    link: '/shop/categorie.html',
    src: '/assets/cat2.jpg',
    nbrCollection: 8
  }
] %}

<section data-component="Slider"
  data-option-mode="left"
  data-option-fit-bounds
  data-option-contain
  class="overflow-hidden max-w-screen py-10 m:py-16">
  <div class="container">
    <div data-component="SliderDrag"
      data-ref="wrapper"
      tabindex="0"
      class="homepage-hero relative z-1 whitespace-nowrap select-none h-full flex flex-row flex-nowrap [&>*]:cursor-grab gap-2 m:gap-8">
      {% for category in categories %}
        {% include '@components/ui/card/card-category.twig' with {
          title: category.title,
          nbrCollection: category.nbrCollection,
          src: category.src,
          link: category.link
        } %}
      {% endfor %}
    </div>
    <div class="flex items-center justify-between mt-10 gap-8">
      <div class="buttons hidden m:flex items-center gap-4">
        <button title="Prev"
          type="button"
          data-component="SliderBtn"
          data-option-prev
          class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
          {% include '@ui/Icon/Icon.twig' with {
            name: 'arrow-line-desktop',
            attr: {
              class: ['rotate-180', 'w-14', 'block']
            }
          } %}
        </button>
        <button title="Next"
          type="button"
          data-component="SliderBtn"
          data-option-next
          class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
          {% include '@ui/Icon/Icon.twig' with {
            name: 'arrow-line-desktop',
            attr: {
              class: ['w-14', 'block']
            }
          } %}
        </button>
      </div>
      <div data-component="SliderProgress"
        class="w-full rounded bg-gradient-to-r from-gray/20 to-transparent overflow-hidden flex-1 h-px relative">
        <div class="h-px bg-purple rounded origin-left duration-1000 transition ease-in-out before:content-[''] before:absolute before:w-1/4 before:h-full before:bg-purple before:translate-x-full before:right-0 before:top-0"
          data-ref="progress"></div>
      </div>
    </div>
  </div>
</section>
