{% extends '@components/table/default.twig' %}

{% set can_edit = can_edit is defined ? can_edit : true %}

{% set head_row_attr = {
  class: 'max-m:hidden *:py-2'
} %}

{% set row_attr = {
  class: 'max-m:relative max-m:grid max-m:grid-cols-3 max-m:gap-4 max-m:*:p-0 max-m:pb-6 max-m:pt-10 *:py-2'
} %}

{% set cell_attr_required = {
  class: 'uppercase text-brown text-xs font-sans font-medium align-center'
} %}

{% set columns = [
  {
    label: 'Visuel',
    key: 'img',
    head_cell_attr: {
      class: 'sr-only'
    },
    cell_attr: {
      class: 'max-m:row-span-3'
    }
  },
  {
    label: 'Code article',
    key: 'code',
    cell_attr: {
      class: 'max-m:col-span-2'
    }
  },
  {
    label: 'Désignation',
    key: 'name',
    cell_attr: {
      class: 'max-m:col-span-2'
    }
  },
  {
    label: 'Quantité',
    key: 'quantity',
    cell_attr: {
      class: '!align-middle'
    }
  }
] %}

{% block cell_img %}
  {% if value %}
    <div class="ring-inset ring-1 ring-brown/20 p-px size-12 bg-sand-darker">
      <img src="{{ value }}"
        alt=""
        class="size-full object-contain mix-blend-multiply"
        loading="lazy" />
    </div>
  {% endif %}
{% endblock %}

{% block cell_name %}
  <div class="text-xs font-sans font-medium leading-none uppercase text-gray">{{ row.title }}</div>
{% endblock %}

{% block cell_quantity %}
  <p class="text-sm font-sans font-medium leading-4 uppercase text-gray text-center">
    <span class="m:sr-only">Quantité<br /></span>{{ value }}
  </p>
{% endblock %}
