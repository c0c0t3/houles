{#
/**
 * @file
 * Button component.
 *
 * @param string $label
 * @param string $tag
 * @param string $href
 * @param array $attr
 * @param string|false $icon False to hide the default decoration.
 * @param array  $icon_attr
 * @param 'solid'|'outline'|'link' $variant
 * @param boolean $invert For dark backgrounds.
 * @param 'start'|'end' $icon_position
 * @param boolean $icon_only
 */
#}

{# Customizable tag with a default value. #}
{% set tag =
  tag|default(href is defined or (attr is defined and attr.href is defined) ? 'a' : 'button')
%}

{# Default variant values #}
{% set variant = variant|default('solid') %}
{% set invert = invert|default(false) %}

{# Default icon values #}
{% set icon_position = icon_position|default('start') %}
{% set icon_only = icon_only|default(false) %}

{# Final attributes are a merge of the defaults, the given and then the required #}
{% set attributes =
  merge_html_attributes(
    attr ?? null,
    {
      type: tag == 'button' ? 'button' : false,
      href: tag == 'a' and href is defined ? href : false,
      aria_label: icon_only ? label : false,
      title: title ?? icon_only ? label : false
    },
    {
      class: [
        'btn',
        {
          'btn--outline': variant == 'outline',
          'btn--link': variant == 'link',
          'btn--icon-only': icon_only,
          'btn--reverse': icon_position == 'end',
          'btn--simple': icon == false,
          'btn--invert': invert,
          'btn--small': size == 'small'
        }
      ]
    }
  )
%}

{% html_element tag with attributes %}
  {% block content %}
    {% block icon %}
      {% if icon is defined and icon != false %}
        {% include '@ui/Icon/Icon.twig' with {
          name: icon ?? '',
          attr: merge_html_attributes(
            icon_attr ?? null,
            {
              class: ['size-[1lh] [&>svg]:w-full [&>svg]:h-full']
            },
            {}
          )
        } only %}
      {% endif %}
    {% endblock %}
    {% if not icon_only %}
      {% block label %}
        <span>{{ label }}</span>
      {% endblock %}
    {% endif %}
  {% endblock %}
{% end_html_element %}
