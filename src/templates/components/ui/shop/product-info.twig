<div class="col-span-1">
  {# Drift Zoom Container #}
  <div class="relative">
    <div class="hidden m:block absolute top-0 z-30 inset-y-0 w-full left-0 pointer-events-none">
      <div class="zoom-panel sticky top-28 xs:max-h-[50svh] m:max-h-[calc(100svh-8rem)] m:h-[800px] has-[*]:ring-1 ring-purple/20 has-[*]:bg-sand-darker [&_img]:mix-blend-multiply"></div>
    </div>
  </div>

  {# PRODUCT MAIN INFOS / START #}
  <div class="w-full m:max-w-xl mx-auto p-4 m:p-0">
    {# Title & Price #}
    <div class="flex flex-col l:flex-row items-start justify-between l:items-center gap-4 l:gap-8 mb-6">
      {# Product title #}
      <div class="flex-1">
        <span class="text-sm text-brown tracking-wider uppercase font-medium">{{ category }}</span>
        <h2 class="font-serif text-3xl m:text-4xl uppercase leading-none text-gray">{{ title }}</h2>
      </div>

      {# Product price #}
      <div class="flex flex-col items-start l:items-end gap-1 l:gap-2">
        {% if promotion %}
          {# Regular price #}
          <div class="text-xxs space-x-2 font-medium">
            <span class="text-brown uppercase line-through">{{ price }} € HT</span>
            <span class="px-2 py-1 rounded bg-brown-light text-purple">
              {{ promo_discount }} {{ promo_suffix }}
            </span>
          </div>

          {# Promo price #}
          <div>
            {# <span class="text-sm text-gray uppercase font-medium">{{ promo_price }} € HT</span> #}
            <span class="text-sm text-gray uppercase font-medium">EUR 5,06 excl. taxes / Meter</span>
            
          </div>
        {% endif %}
      </div>
    </div>

    {# Ref & Stock #}
    <div class="flex flex-col s:flex-row items-start s:items-center justify-start gap-2 text-xs text-brown tracking-widest uppercase font-medium s:divide-x divide-gray/20">
      {# REF #}
      <span>REF: {{ ref }}</span>

      {# STOCK #}
      <div class="flex items-center justify-end gap-2 s:pl-2">
        {% if is_in_stock %}
          {% set fill_color = '#5C8871' %}
        {% else %}
          {% set fill_color = '#E9304C' %}
        {% endif %}

        <svg aria-hidden="true"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          class="size-3 flex-shrink-0">
          <circle cx="6" cy="6" r="4" fill="{{ fill_color }}" />
        </svg>

        {% if is_in_stock and stock > 0 %}
          <span class="">STOCK : {{ stock }} PE</span>
        {% elseif stock == 0 and tooltip_stock %}
          <span class="">STOCK : <span class="text-red">0</span> PE</span>
          {% embed '@components/ui/basic-tooltip.twig'
            with {
              tooltip_content: tooltip_stock
            }
          %}

          {% endembed %}
        {% else %}
          <span class="">NC</span>
        {% endif %}
      </div>

      {# ASK FOR STOCK #}
      {% if stock == 0 %}
        <button role="button"
          class="uppercase underline s:pl-2"
          data-component="Action"
          data-option-target="Panel(#ask-stock)"
          data-option-effect="target.open()">
          Demande de stock
        </button>
      {% endif %}
    </div>
    {% include '@components/modal/product-ask-stock.twig' %}

    <div class="h-px w-full bg-brown/20 my-10"></div>

    {# PRODUCT FORM / START #}
    <form action="">
      {% for product_variant in product_variants %}
        {% include '@components/ui/shop/product-variant-picker.twig' with product_variant %}
      {% endfor %}
      <div class="grid grid-cols-12">
        {% if qty_type == 'select' %}
          <select id="list"
            name="list"
            class="block col-span-3 m:col-span-2 px-6 py-4 text-sm font-sans font-medium leading-6 bg-transparent ring-1 ring-current rounded-lg appearance-none">
            {% for i in 1..10 %}
              <option value="{{ i }}">{{ i }}</option>
            {% endfor %}
          </select>
        {% else %}
          <input class="block col-span-3 m:col-span-2 font-sans font-medium text-sm leading-6 ring-1 ring-inset rounded-lg bg-transparent text-purple ring-purple py-4 pl-6 pr-2 focus-visible:bg-white appearance-none"
            value="1"
            name="line[1][quantity]"
            type="number" />
        {% endif %}
        <div class="col-span-9 m:col-span-10 pl-4 flex flex-col items-center justify-center">
          {% include '@components/button.twig' with {
            label: 'Ajouter au panier',
            variant: 'solid',
            icon: 'add-to-cart',
            attr: {
              type: 'submit',
              class: 'product-info-add-to-cart-button w-full'
            }
          } only %}
        </div>
      </div>
    </form>
    {# PRODUCT FORM / END #}

    {# PRODUCT MISC CTA / START #}
    <div class="grid grid-cols-12 pl-4 mt-2">
      <div class="col-span-12 s:col-start-4 m:col-start-3 s:col-span-9 m:col-span-10 flex flex-col items-center gap-2">
        {% include '@components/button.twig' with {
          label: 'Commander un échantillon',
          href: '#otherlinks',
          variant: 'link'
        } only %}
        {% include '@components/button.twig' with {
          label: 'Ajouter un set de tringlerie',
          variant: 'link',
          attr: {
            'data-component': 'Action',
            'data-option-target': 'Panel(#tringlerie)',
            'data-option-effect': 'target.open()'
          }
        } only %}
        {% include '@components/button.twig' with {
          label: 'Configurateur de système de tirage',
          variant: 'link',
          attr: {
            'data-component': 'Action',
            'data-option-target': 'Panel(#configurateur-tirage)',
            'data-option-effect': 'target.open()'
          }
        } only %}
      </div>
    </div>
    {% include '@components/modal/tringlerie.twig' %}
    {% include '@components/modal/configurateur-tirage.twig' %}
    {# PRODUCT MISC CTA / END #}

    {# PRODUCT ACCORDIONS / START #}
    <div class="pt-10">
      {% set accordionButtonClass =
        'group py-6 flex justify-between items-center w-full cursor-pointer text-sm uppercase font-medium text-purple'
      %}

      {% set accordionButtonIcon2 %}
        <div data-ref="accordionButtonIcon"
          class="accordion-button-icon w-6 h-6 relative transition-transform duration-500">
          <span class="accordion-button-icon-line absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 block w-4 h-px bg-purple"></span>
          <span class="accordion-button-icon-line-2 absolute rotate-90 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 block w-4 h-px bg-purple transition-all"></span>
        </div>
      {% endset %}

      {% for more_info in more_infos %}
        <div class="border-b border-brown/20 last:border-none first:border-t">
          {% embed '@components/ui/accordion-item.twig'
            with {
              accordionButtonClass: accordionButtonClass,
              accordionButtonAnchor: more_info.title,
              accordionButtonIcon: accordionButtonIcon2
            }
          %}
            {% block content %}
              <div class="pb-6 prose text-base">{{ more_info.content }}</div>
            {% endblock %}
          {% endembed %}
        </div>
      {% endfor %}
    </div>
    {# PRODUCT ACCORDIONS / END #}
  </div>
  {# PRODUCT MAIN INFOS / END #}
</div>

{% set tooltip_hors_supports %}
  <span class="text-red-600">
    Attention : les supports (mur / plafond / naissances) ne sont pas compris dans cette
    configuration.
  </span>
  <br /> Pensez à les rajouter dans votre panier en choisissant le modèle approprié à votre configuration
  (mur, plafond, mur à mur…)<div class="flex gap-8 items-center justify-center">
    <div><img src="/assets/rail/support_mur.jpg" alt="support_mur.jpg" width="200px" /></div>
    <div>
      <img src="/assets/rail/support_plafond.jpg" alt="support_plafond.jpg" width="200px" />
    </div>
    <div>
      <img src="/assets/rail/naissance_murale.jpg" alt="naissance_murale.jpg" width="200px" />
    </div>
  </div>
  <b>Note sur les embouts :</b> seuls les supports sont à rajouter à votre configuration. Inutile de
  rajouter des embouts car les cache-poulies font office d'embouts.<div class="flex gap-8 items-center justify-center">
    <img src="/assets/rail/embout.webp" alt="embout.png" width="200px" />
  </div>
{% endset %}

{% embed '@components/modal/modal-tooltip.twig'
  with {
    content_attr: {
      class: 'HOLA flex flex-col gap-4 items-center p-4 s:p-6 m:p-8 [&_img]:mix-blend-multiply'
    },
    attr: {
      id: 'tooltip_hors_supports'
    }
  }
%}
  {% block content %}
    {{ tooltip_hors_supports }}
  {% endblock %}
{% endembed %}
