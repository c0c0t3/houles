{% set colorisList = [] %}
{% for code, hex in coloris %}
  {% set colorisList = colorisList|merge([{ value: code, label: code, color:hex }]) %}
{% endfor %}


<div id="coloris_modal" class="{{
  html_classes(
    [
      'fixed bottom-0 inset-x-0 m:absolute m:-inset-1 bg-sand z-40',
      'opacity-0 -translate-y-8',
      'transition-all duration-300 ease-in-out',
      'pointer-events-none',
      'p-4 m:p-0',
      'border-t border-[#E5E2DA] l:border-none'
    ]
  )
  }}">

  <div class="flex flex-col gap-4 m:gap-10 items-stretch">

    {# MODAL TITLE // DESKTOP ONLY#}
    <div class="hidden m:flex justify-between items-center">
      <h2 class="text-3xl font-medium font-serif uppercase">choix du coloris</h2>
      <button type="button"
        class="js--close-coloris-modal size-12 ring-1 bg-transparent ring-purple text-purple rounded-lg flex items-center justify-center group">
        {% include '@ui/Icon/Icon.twig' with {
          name: 'plus',
          attr: {
            class: [
              'w-6',
              'flex items-center justify-center',
              'rotate-45 group-hover:rotate-[225deg] transition-transform duration-500 ease-out-expo'
            ]
          }
        } %}
      </button>
    </div>

    {# ZONES SELECTOR #}
    <div>
      {% include '@components/ui/shop/product-info-svp-zone.twig' with { zones: zones, close_modal_button: true } only %}
    </div>

    {# COLORIS SELECTOR WITH SEARCH #}
    <div class="hidden l:flex justify-between items-center">
      <span class="text-sm leading-none font-medium uppercase text-purple">Chercher votre coloris</span>
      {% include '@components/select-choices.twig' with {
        label: 'Coloris',
        name: 'coloris_select',
        flag: false,
        color: true,
        required: true,
        search: true,
        options: colorisList,
        attr: {
          class: class ?? 'hidden l:flex w-1/2'
        },
        label_attr: {
          class: 'hidden'
        }
      } only %}
    </div>

    {# COLORIS PICKER #}
    <div class="">
      <span class="block text-xs s:text-sm leading-none font-medium uppercase text-purple mb-4">Ou sélectionnez le :</span>
      <div class="grid grid-flow-col auto-rows-auto grid-rows-1 m:grid-rows-3 gap-2 m:flex m:flex-wrap overflow-x-auto -mx-4 px-4 l:px-px l:mx-0 py-px">
        {% for key, value in coloris %}
          <button class="button_color size-6 rounded-full border border-purple/20 button-selected:ring-purple button-selected:border-purple button-selected:ring-1"
              type="button"
              name="button"
              style="background-color: {{ value }};"
              data-hex="{{ value }}"
              data-id="{{ loop.index }}"
              data-vendorcode="{{ key }}"
              data-matiere="1">
            <div class="bubble_text hidden invisible">{{ key }}</div>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="max-s:hidden">
      <span class="text-purple text-xs s:text-sm uppercase font-medium mb-4 block">Derniers coloris sélectionnés</span>
      <ul id="lastColorBlock" class="flex gap-2"></ul>
    </div>

    <div class="hidden m:flex gap-4">
      {% include '@components/button.twig' with {
        label: 'Génération aléatoire',
        variant: 'outline',
        icon: false,
        attr: {
          id: 'create_product_random',
          type: 'button',
          class: 'product-info-add-to-cart-button w-full l:col-span-5'
        }
      } only %}
      {% include '@components/button.twig' with {
        label: 'Sauvegarder',
        variant: 'solid',
        icon: 'download',
        attr: {
          id: 'button_save_project',
          type: 'button',
          class: 'product-info-add-to-cart-button w-full l:col-span-5'
        }
      } only %}
      {% include '@components/button.twig' with {
        label: 'Imprimer mon projet',
        variant: 'outline',
        icon: 'icon-reset',
        icon_only: true,
        attr: {
          id: 'button_print_project',
          class: 'w-full l:col-span-2 shrink-0',
          type: 'button'
        }
      } only %}
    </div>


  </div>

</div>



