{% set type = distributor.showroom ? 'showroom' : 'reseller' %}

<article data-nom="{{ distributor.name }}"
{% if distributor.lat and distributor.lng %}
  data-ref="StoreLocator.distributors[]"
{% endif %}
  data-type="{{ type }}"
  data-lat="{{ distributor.lat }}"
  data-lng="{{ distributor.lng }}"
  class="distributor-card p-4 text-gray flex flex-col gap-4">
  <h3 class="block text-sm uppercase font-medium">{{ distributor.name }}</h3>
  <div class="flex justify-between items-end text-base font-normal">
    <address class="not-italic">
      {{ distributor.address }}
      <br />
      {{ distributor.postcode }} {{ distributor.city }}
      {% if distributor.distributor %}
        <br />
        {{ distributor.distributor }}
      {% endif %}
    </address>
    <div class="text-sm text-right">
      <a href="mailto:{{ distributor.email }}">{{ distributor.email }}</a><br />
      <a href="tel:{{ distributor.phone }}">{{ distributor.phone }}</a>
      {% if distributor.website %}
        <br />
        <span>{{ distributor.fax }}</span>
      {% endif %}
    </div>
  </div>
  {% if distributor.products %}
    <div class="flex items-center gap-2 justify-between bg-sand-darker/50 rounded-lg p-4">
      <span class="uppercase font-medium text-xs opacity-50">Produits proposés :</span>
      <ul class="text-xs uppercase font-medium flex justify-end flex-wrap gap-2">
        {% for product in distributor.products %}
          <li>{{ product.name }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</article>
