<section class="{{ class }}">
  <div class="container">
    <div class="flex items-center justify-end">
      {% if current_tags %}
        <div class="hidden m:flex items-center justify-start flex-1 gap-2">
          {% for tag in current_tags %}
            <button class="hidden m:block text-sm text-purple uppercase font-medium tracking-wider leading-none border border-purple ring-purple hover:ring-1 rounded-lg p-4">
              {{ tag.name }}
            </button>
          {% endfor %}
          {% include '@components/button.twig' with {
            label: 'Voir plus',
            variant: 'link',
            icon: false,
            attr: {
              type: 'button',
              data_component: 'Action',
              data_option_target: 'Panel(#facets)',
              data_option_effect: 'target.open()',
              class: 'ml-4'
            }
          } only %}
        </div>
      {% endif %}
      <button data-component="Action"
        data-option-target="Panel(#facets)"
        data-option-effect="target.open()"
        class="text-sm rounded-lg text-purple border border-purple ring-purple hover:ring-1 uppercase font-medium tracking-wider leading-none p-4 shrink-0">
        Filtres
      </button>
    </div>
  </div>
</section>

