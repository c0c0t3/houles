<nav data-ref="megaMenu"
  class="{{
  html_classes(
    [
      'fixed z-50 inset-0 bg-purple-light text-white transition-all delay-200 duration-500 ease-in-out',
      'pointer-events-none opacity-0 -translate-x-1/4',
      'group group-open:opacity-100 group-open:pointer-events-auto group-open:-translate-x-0'
    ]
  )
  }}">
  {# Background images #}
  <div class="megamenu_background-images hidden s:block absolute z-0 inset-0 pointer-events-none">
    <img src="/assets/projet1.jpg"
      alt=""
      class="absolute scale top-0 left-0 w-full h-full object-cover" />
    {% for section in menu %}
      <img data-ref="ImageSection[]"
        data-image="section-{{ loop.index }}"
        class="opacity-0 absolute top-0 left-0 w-full h-full object-cover transition-all duration-500 ease-in-out scale-110"
        src="{{ section.image }}"
        alt="{{ section.name }}" />
    {% endfor %}
  </div>

  {# Menu #}
  <div class="{{
    html_classes(
      [
        'megamenu_menu',
        'absolute',
        'flex flex-col justify-between',
        'z-10',
        'top-0 left-0',
        'h-dvh w-screen',
        's:w-1/2 max-w-xl xl:max-w-2xl',
        'pt-0 s:pt-28 pb-8 s:pb-14',
        'after:absolute after:inset-0 after:bg-purple-light after:-z-1',
        '-translate-x-full',
        'group-open:translate-x-0 group-open:opacity-100',
        'transition-all duration-700 ease--out'
      ]
    )
    }}">
    {# Menu Principal - shop #}
    <div class="flex-1 divide-y divide-white/20">
      {# Close menu button #}
      <button data-ref="btnCloseMenu"
        class="relative py-4 s:py-0 s:absolute z-20 s:top-8 s:left-8 text-6xl flex items-center gap-4">
        <img class="rotate-45" src="/assets/plus.svg" aria-label="fermer le menu" />
        <span class="hidden s:block font-sans text-sm uppercase font-medium">Fermer</span>
      </button>

      {% for section in menu %}
        {# Font size #}
        {% if section.type == 'large' %}
          {% set fontSize = 'text-2xl s:text-4xl' %}
          {% set buttonSize = 'w-10 h-10' %}
        {% else %}
          {% set fontSize = 'text-base s:text-2xl' %}
          {% set buttonSize = 'w-8 h-8 mr-1' %}
        {% endif %}

        {# Menu section #}
        <div data-ref="SectionMenu[]"
          data-section="section-{{ loop.index }}"
          class="menu-section py-4 px-4 s:pl-12 s:pr-8">
          {% if section.submenus %}
            <div data-ref="btnOpenSubMenu[]"
              class="first-panel flex items-center justify-between cursor-pointer">
              <span class="font-serif uppercase {{ fontSize }}">{{ section.name }}</span>

              {# Open sub menu button #}
                <button class="text-6xl" data-section="section-{{ loop.index }}">
                  <div class="{{
                    buttonSize
                    }} relative parent-is-active:rotate-180 transition-transform duration-500">
                    <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 block w-3/5 h-px bg-white"></span>
                    <span class="absolute rotate-90 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 block w-3/5 h-px bg-white transition-all duration-200 parent-is-active:opacity-0"></span>
                  </div>
                </button>

            </div>

            <div data-simplebar class="{{
              html_classes(
                [
                  'second-panel',
                  'absolute bottom-0 left-0 top-0',
                  'overflow-y-auto',
                  'h-full w-full xl:w-3/4',
                  'bg-purple',
                  'px-4 py-28 s:px-12',
                  'pointer-events-none opacity-0',
                  'z-1 s:-z-1',
                  '-translate-x-8',
                  'transition-all duration-300 ease-in-out',
                  'parent-is-active:opacity-100',
                  'parent-is-active:pointer-events-auto',
                  'parent-is-active:translate-x-0',
                  's:parent-is-active:left-full'
                ]
              )
              }}"
              data-ref="subMenu[]"
              data-submenu="section-{{ loop.index }}">
              <button data-ref="backButton"
                class="s:hidden mb-2 text-sm uppercase font-medium text-white flex items-center gap-2">
                <svg class="size-4"
                  viewBox="0 0 18 19"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 14.5741L3.9375 9.51163M3.9375 9.51163L9 4.44913M3.9375 9.51163H14.0625"
                    stroke="white"
                    stroke-linecap="square"
                    stroke-linejoin="round" />
                </svg>Retour au menu
              </button>

              {% for submenu in section.submenus %}
                {% if submenu.items %}
                  <div class="sub-menu-section__section uppercase border-b border-white/20 last:border-b-0">
                    {% set accordionContent %}
                      <ul class="text-sm uppercase font-medium pb-6">
                        {% for item in submenu.items %}
                          <li class="flex gap-2 items-center leading-none py-2 relative">
                            <a class="hover:underline" href="{{ item.link }}">
                              {{ item.name }}
                            </a>

                            {# Affichage de l’icône si définie #}
                            {% if item.icon %}
                              {% if item.icon == 'fire' %}
                                {% include '@ui/Icon/Icon.twig' with {
                                  name: 'icon-fire',
                                  attr: {
                                    class: ['[&>svg]:size-4', 'text-purple rounded bg-brown-light px-2 py-1 -my-2'],
                                    aria_hidden: true
                                  }
                                } only %}
                              {% endif %}
                              {# Ajoute ici d'autres cas si tu veux gérer plus de types d’icônes #}
                            {% endif %}

                            {# Tag s’il existe #}
                            {% set tag = item.tag
                              ? '<span class="inline-block text-xs group-hover/link:no-underline uppercase font-medium text-purple rounded bg-brown-light px-2 py-1 -my-2">'
                                ~ item.tag
                                ~ '</span>'
                              : ''
                            %}
                            {{ tag|raw }}
                          </li>
                        {% endfor %}
                      </ul>
                    {% endset %}

                    {% set accordionButtonClass =
                      'group-hover/accordionitem:text-white py-6 flex justify-between items-center w-full cursor-pointer text-xs uppercase font-medium text-brown-light'
                    %}
                    {% set accordionButtonIcon2 %}
                      <div data-ref="accordionButtonIcon"
                        class="accordion-button-icon w-6 h-6 relative transition-transform duration-500">
                        <span class="accordion-button-icon-line absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 block w-4 h-px bg-white"></span>
                        <span class="accordion-button-icon-line-2 absolute rotate-90 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 block w-4 h-px bg-white transition-all"></span>
                      </div>
                    {% endset %}

                    {% include '@components/ui/accordion-item.twig' with {
                      accordionButtonClass: accordionButtonClass,
                      accordionButtonAnchor: submenu.name,
                      accordionButtonIcon: accordionButtonIcon,
                      accordionContent: accordionContent
                    } %}
                  </div>
                {% else %}
                  <div class="sub-menu-section__section uppercase border-b border-white/20 last:border-b-0">
                    <a class="hover:text-white py-6 flex justify-between items-center w-full cursor-pointer text-xs uppercase tracking-wide font-medium text-brown-light"
                      href="{{ submenu.link }}">
                      {{ submenu.name }}
                    </a>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <a class="font-serif uppercase {{ fontSize }}" href="{{ section.link }}">
              {{ section.name }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {# Menu Secondaire - editorial #}
    <div class="flex justify-between items-end mt-6 px-4 s:px-12">
      <div class="flex flex-1 flex-col gap-2">
        {% for item in bottomLeftMenu %}
          <a class="text-xs uppercase font-medium text-white" href="{{ item.link }}">
            {{ item.name }}
          </a>
        {% endfor %}
      </div>
      <div class="flex flex-1 flex-col gap-2">
        {% for item in bottomRightMenu %}
          <a class="text-xs uppercase font-medium text-white" href="{{ item.link }}">
            {{ item.name }}
          </a>
        {% endfor %}
        <nav data-component="Menu" class="relative inline-block h-4 leading-none">
          <button data-component="MenuBtn" class="text-xs uppercase font-medium text-white">
            Langue et pays
          </button>
          <div data-component="MenuList"
            data-option-enter-from="transform scale-95 opacity-0 pointer-events-none"
            data-option-enter-active="transition duration-200 ease-out-expo"
            data-option-leave-active="transition duration-200 ease-out-expo"
            data-option-leave-to="transform scale-95 opacity-0 pointer-events-none"
            class="z-10 w-80 absolute bottom-full mb-4 left-0 -translate-x-1/2 origin-top-left transform scale-95 opacity-0 pointer-events-none p-4 s:p-8 bg-white text-purple ring-1 ring-purple rounded-lg">
            {% include '@components/ui/header/header-country-lang.twig' %}
          </div>
        </nav>
      </div>
    </div>
  </div>
</nav>
