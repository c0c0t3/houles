{% set words = tooltip_content|split(' ')|length %}
{% set widthClass = words <= 4 ? 'w-fit whitespace-nowrap' : 'w-full min-w-80' %}

<div data-component="Menu"
  data-option-mode="hover"
  class="relative inline-block leading-none cursor-pointer text-purple/50 hover:text-purple">
  {% block trigger %}
    <svg data-component="MenuBtn"
      class="w-5 h-5 -mb-1.5 -translate-y-0.5"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor">
      <path fill-rule="evenodd"
        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
        clip-rule="evenodd" />
    </svg>
  {% endblock %}
  <div data-component="MenuList"
    data-option-enter-from="transform scale-95 opacity-0 pointer-events-none"
    data-option-enter-active="transition duration-200 ease-out-expo"
    data-option-leave-active="transition duration-200 ease-out-expo"
    data-option-leave-to="transform scale-95 opacity-0 pointer-events-none"
    class="z-10 {{
    widthClass
    }} absolute bottom-full mb-4 left-0  -translate-x-1/2 origin-top-left transform scale-95 opacity-0 pointer-events-none p-4 bg-purple text-white rounded-lg">
    {{ tooltip_content }}
  </div>
</div>
