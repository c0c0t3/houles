{% embed '@components/modal/Panel.twig'
  with {
    attr: {
      id: 'ask-stock'
    },
    position: 'right',
    overlay_attr: {
      class: 'z-50 bg-black/40 absolute inset-0'
    },
    wrapper_attr: {
      class: 'p-4 m:p-6 z-50 items-center m:mr-10'
    },
    container_attr: {
      class: 'w-full max-w-xl rounded bg-sand !overflow-hidden flex justify-stretch'
    },
    content_attr: {
      class: 'p-4 s:p-6 m:p-8 w-full flex flex-col'
    }
  }
%}
  {% block open %}{% endblock %}
  {% block close %}{% endblock %}
  {% block content %}
    <form id="wishlist-form" class="h-full flex flex-col">
      {# Facets Modal Header #}
      <div class="flex items-center justify-between shrink-0 mb-6">
        <h2 class="font-serif text-2xl m:text-3xl uppercase leading-none text-gray">
          Demande de stock
        </h2>
        {% include '@components/modal/close-modal-button.twig' with {
          attr: {
            data_ref: 'close[]',
            type: 'button'
          }
        } only %}
      </div>

      {# Facets Modal Content #}
      <div data-simplebar class="flex flex-col gap-6 pt-4 p-px flex-1 overflow-auto">
        <p>
          Lorem, ipsum dolor sit amet consectetur adipisicing elit. Sequi, voluptas eligendi atque
          veritatis nulla sit repellat error obcaecati assumenda quasi autem veniam aliquid eum,
          distinctio odio est quis earum similique!
        </p>
      </div>

      {# Facets Modal Footer #}
      <div class="flex flex-col s:flex-row gap-4 s:gap-8 pt-4 s:pt-6 m:pt-8">
        {% include '@components/button.twig' with {
          label: 'Envoyer ma demande',
          variant: 'solid',
          attr: {
            class: 'w-full flex-1',
            type: 'submit'
          }
        } only %}
      </div>
    </form>
  {% endblock %}
{% endembed %}
