{% embed '@components/modal/Panel.twig'
  with {
    attr: {
      id: 'wishlist-new-list'
    },
    position: 'right',
    overlay_attr: {
      class: 'z-50 bg-black/40 absolute inset-0'
    },
    wrapper_attr: {
      class: 'p-4 m:p-6 z-50 items-center m:mr-10'
    },
    container_attr: {
      class: 'w-full max-w-xl rounded bg-sand !overflow-hidden flex justify-stretch'
    },
    content_attr: {
      class: 'p-4 s:p-6 m:p-8 w-full flex flex-col'
    }
  }
%}
  {% block open %}{% endblock %}
  {% block close %}{% endblock %}
  {% block content %}
    <form id="wishlist-form" class="h-full flex flex-col">
      {# Facets Modal Header #}
      <div class="flex items-center justify-between shrink-0 mb-6">
        <h2 class="font-serif text-2xl m:text-3xl uppercase leading-none text-gray">
          Créer une nouvelle liste
        </h2>
        <button type="button"
          data-ref="close[]"
          class="accordion-button-icon size-10 m:size-14 relative transition-transform duration-500 ring-1 ring-purple rounded-lg">
          <span class="accordion-button-icon-line absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rotate-45 block w-4 m:w-6 h-px bg-purple"></span>
          <span class="accordion-button-icon-line-2 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-45 block w-4 m:w-6 h-px bg-purple transition-all"></span>
        </button>
      </div>

      {# Facets Modal Content #}
      <div data-simplebar class="pt-4 p-px flex-1 overflow-auto">
        <div class="flex flex-col gap-6">
          {% include '@components/field.twig' with {
            label: 'Nom',
            name: 'new_list_name'
          } only %}
          {% include '@components/field.twig' with {
            label: 'Description',
            type: 'textarea',
            input_attr: {
              rows: 5
            },
            name: 'new_list_description'
          } only %}
        </div>
      </div>

      {# Facets Modal Footer #}
      <div class="flex flex-col s:flex-row gap-4 s:gap-8 pt-4 s:pt-6 m:pt-8">
        {% include '@components/button.twig' with {
          label: 'Annuler',
          variant: 'link',
          icon: false,
          attr: {
            'data-ref': 'close[]',
            type: 'button'
          }
        } only %}
        {% include '@components/button.twig' with {
          label: 'Créer la liste',
          variant: 'solid',
          attr: {
            class: 'w-full flex-1',
            type: 'button',
            'data-ref': 'close[]'
          }
        } only %}
      </div>
    </form>
  {% endblock %}
{% endembed %}
