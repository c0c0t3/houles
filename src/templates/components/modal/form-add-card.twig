<form class="space-y-4" action="">
  {% include '@components/field.twig' with {
    label: 'Nom complet',
    name: 'name',
    type: 'text',
    required: true
  } only %}
  {% include '@components/field.twig' with {
    label: 'Numéro de carte',
    name: 'card_number',
    type: 'number',
    required: true
  } only %}
  <div class="grid s:grid-cols-2 gap-x-4 w-full">
    {% include '@components/field.twig' with {
      label: "Date d'expiration",
      name: 'expiration_date',
      type: 'date',
      required: true,
      input_attr: {
        class: 'w-full flex-1'
      }
    } only %}
    {% include '@components/field.twig' with {
      label: 'CCV',
      name: 'ccv',
      type: 'number',
      required: true,
      input_attr: {
        class: 'w-full flex-1'
      }
    } only %}
  </div>
</form>
