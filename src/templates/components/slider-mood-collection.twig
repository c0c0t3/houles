{% set attributes =
  merge_html_attributes(
    attr ?? null,
    {},
    {
      class: 'overflow-hidden max-w-screen'
    }
  )
%}

{% set collections = [
  {
    title: 'Asara',
    src: '/assets/mood1.png',
    width: 842,
    height: 607
  },
  {
    title: 'THE MICHAEL AIDUSS COLLECTION',
    src: '/assets/mood2.png',
    width: 496,
    height: 512
  },
  {
    title: 'Acea',
    src: '/assets/mood3.png',
    width: 946,
    height: 522
  },
  {
    title: 'Auro',
    src: '/assets/mood4.png',
    width: 1010,
    height: 522
  },
  {
    title: 'Fin de séries',
    src: '/assets/mood5.png',
    width: 458,
    height: 798
  },
  {
    title: 'Fin de séries',
    src: '/assets/mood-a.jpg',
    width: 933,
    height: 1400
  },
  {
    title: 'Fin de séries',
    src: '/assets/mood-b.jpg',
    width: 933,
    height: 1400
  },
  {
    title: 'Fin de séries',
    src: '/assets/mood-c.jpg',
    width: 934,
    height: 934
  }
] %}

<section {{ html_attributes(attributes) }}>
  {% if title %}
    <div class="container">
      <div class="grid m:grid-cols-12 mb-10 m:mb-14 gap-4">
        <h2 class="text-3xl s:text-4xl m:text-6xl font-serif text-gray font-light uppercase leading-xtight m:col-span-6">
          {{ title }}
        </h2>
        {% block description %}{% endblock %}
      </div>
    </div>
  {% endif %}
  <div class="container">
    {# Slider #}
    <div data-component="Slider"
      data-option-mode="left"
      data-option-fit-bounds
      data-option-contain
      class="space-y-12 w-full">
      <div class="-mx-4 px-4 s:px-0 s:mx-0">
        <div data-component="SliderDrag"
          data-ref="wrapper"
          tabindex="0"
          class="relative z-1 whitespace-nowrap select-none h-full flex flex-row flex-nowrap gap-4 m:gap-8">
          {# Loop images #}
          {% for collection in collections %}
            <div data-component="SliderItem"
              class="inline-block w-full h-96 aspect-square s:aspect-[var(--width)/var(--height)]"
              style="--width: {{ collection.width }}; --height: {{ collection.height }};">
              {% include '@ui/Figure/Figure.twig' with {
                src: collection.src,
                width: collection.width,
                height: collection.height,
                absolute: true,
                title: collection.title,
                fit: 'cover',
                attr: {
                  data_option_enter_from: 'opacity-0 transform scale-110',
                  data_option_enter_active: 'transition duration-1000 ease-out-expo'
                },
                inner_attr: {
                  class: 'bg-vp-bg'
                },
                img_attr: {
                  class: 'opacity-0 transform scale-110'
                }
              } only %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="flex items-center justify-between mt-10 gap-8">
        <div class="buttons hidden m:flex items-center gap-4">
          <button title="Prev"
            type="button"
            data-component="SliderBtn"
            data-option-prev
            class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
            {% include '@ui/Icon/Icon.twig' with {
              name: 'arrow-line-desktop',
              attr: {
                class: ['rotate-180', 'w-14', 'block']
              }
            } %}
          </button>
          <button title="Next"
            type="button"
            data-component="SliderBtn"
            data-option-next
            class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
            {% include '@ui/Icon/Icon.twig' with {
              name: 'arrow-line-desktop',
              attr: {
                class: ['w-14', 'block']
              }
            } %}
          </button>
        </div>
        <div data-component="SliderProgress"
          class="w-full rounded bg-gradient-to-r from-gray/20 to-transparent overflow-hidden flex-1 h-px relative">
          <div class="h-px bg-purple rounded origin-left duration-1000 transition ease-in-out before:content-[''] before:absolute before:w-1/4 before:h-full before:bg-purple before:translate-x-full before:right-0 before:top-0"
            data-ref="progress"></div>
        </div>
      </div>
    </div>
  </div>
</section>
