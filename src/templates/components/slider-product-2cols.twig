<section data-component="Slider"
  data-option-mode="left"
  data-option-fit-bounds
  data-option-contain
  class="overflow-hidden max-w-screen py-10 m:py-16">
  <div class="container">
    <div class="s:grid s:grid-cols-12 gap-8">
      <div class="{{
        html_classes(
          [
            'col-span-4 s:pt-20 bg-sand relative',
            'after:pointer-events-none after:hidden after:m:block after:absolute after:z-10 after:top-0 after:right-0 after:w-[3000px] after:h-full after:bg-inherit',
            'before:pointer-events-none before:hidden before:m:block before:absolute before:z-10 before:top-0 before:right-0 before:translate-x-full before:w-8 before:h-full before:bg-gradient-to-r before:from-sand before:to-transparent'
          ]
        )
        }}">
        {# Slider #}
        <div class="relative z-20">
          <h2 class="m:text-4xl text-3xl font-serif text-gray font-light uppercase leading-xtight break-words">
            Produits complémentaires
          </h2>
          <div class="flex items-center justify-between mt-10 gap-8">
            <div class="buttons hidden m:flex items-center gap-4">
              <button title="Prev"
                type="button"
                data-component="SliderBtn"
                data-option-prev
                class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
                {% include '@ui/Icon/Icon.twig' with {
                  name: 'arrow-line-desktop',
                  attr: {
                    class: ['rotate-180', 'w-14', 'block']
                  }
                } %}
              </button>
              <button title="Next"
                type="button"
                data-component="SliderBtn"
                data-option-next
                class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
                {% include '@ui/Icon/Icon.twig' with {
                  name: 'arrow-line-desktop',
                  attr: {
                    class: ['w-14', 'block']
                  }
                } %}
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="col-span-8 relative z-1">
        <div class="-mx-4 px-4 s:px-0 s:mx-0">
          <div data-component="SliderDrag"
            data-ref="wrapper"
            tabindex="0"
            class="relative z-1 whitespace-nowrap select-none h-full flex flex-row flex-nowrap [&>*]:cursor-grab gap-4 m:gap-8">
            {% for product in related_products %}
              <div data-component="SliderItem" class="w-4/5 s:w-80 shrink-0">
                {% include '@components/ui/card/card-listing-product.twig' with {
                  name: product.name,
                  collection: product.collection,
                  url: product.url,
                  regular_price: product.regular_price,
                  sale_price: product.sale_price,
                  is_sale: product.is_sale,
                  image_main: product.image_main,
                  image_hover: product.image_hover,
                  reference: product.reference,
                  is_in_stock: product.is_in_stock,
                  stock: product.stock,
                  is_new: product.is_new,
                  tags: product.tags
                } %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
    <div data-component="SliderProgress"
      class="s:hidden w-full rounded bg-gradient-to-r from-gray/20 to-transparent overflow-hidden flex-1 h-px relative mt-6">
      <div class="h-px bg-purple rounded origin-left duration-1000 transition ease-in-out before:content-[''] before:absolute before:w-1/4 before:h-full before:bg-purple before:translate-x-full before:right-0 before:top-0"
        data-ref="progress"></div>
    </div>
  </div>
</section>
