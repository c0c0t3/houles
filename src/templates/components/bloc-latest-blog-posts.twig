{% set posts = [
  {
    title: 'CHIC DU BLEU !',
    link: '/blog/article.html',
    src: '/assets/blog.jpg',
    src_width: 427,
    src_height: 408,
    categoryTitle: 'Actualité'
  },
  {
    title: 'Houlès, un siècle d’histoire raconté dans notre livre',
    link: '/blog/article.html',
    src: '/assets/blog-2.jpg',
    src_width: 427,
    src_height: 528,
    categoryTitle: 'Actualité'
  },
  {
    title: 'Les passementeries Houlès à l’École Boulle',
    link: '/blog/article.html',
    src: '/assets/blog-3.jpg',
    src_width: 427,
    src_height: 407,
    categoryTitle: 'Actualité'
  }
] %}

<section data-component="Slider"
  data-option-active-breakpoints="xxs xs s m l"
  data-option-mode="left"
  data-option-fit-bounds
  data-option-contain
  class="latest-posts__component overflow-hidden max-w-screen py-14 m:py-28">
  <div class="container">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-3xl s:text-4xl m:text-6xl font-serif text-gray font-light uppercase">
        {{ title|default('Actualités') }}
      </h2>
      <div class="hidden m:block">
        {% include '@components/button.twig' with {
          label: 'Voir toutes nos actualités',
          href: '/shop/collection.html',
          variant: 'link',
          icon_position: 'start'
        } %}
      </div>
    </div>
    <div data-component="SliderDrag"
      data-option-active-breakpoints="xxs xs s"
      data-ref="wrapper"
      tabindex="0"
      class="homepage-hero relative z-1 whitespace-nowrap w-full overflow-hidden select-none h-full flex flex-row flex-nowrap gap-2 s:gap-4 m:gap-8">
      {% for post in posts %}
        <div data-component="SliderItem" class="shrink-0 w-[80%] s:w-1/2 m:w-1/3">
          {% include '@components/ui/card/card-post.twig' with {
            title: post.title,
            categoryTitle: post.categoryTitle,
            src: post.src,
            link: post.link,
            src_width: post.src_width,
            src_height: post.src_height
          } %}
        </div>
      {% endfor %}
    </div>
    <div data-component="SliderProgress"
      class="w-full rounded bg-gradient-to-r from-gray/20 to-transparent overflow-hidden flex-1 h-px relative mt-10 gap-8 m:hidden">
      <div class="h-px bg-purple rounded origin-left duration-1000 transition ease-in-out before:content-[''] before:absolute before:w-1/4 before:h-full before:bg-purple before:translate-x-full before:right-0 before:top-0"
        data-ref="progress"></div>
    </div>
    <div class="flex items-center justify-center m:hidden">
      {% include '@components/button.twig' with {
        label: 'Voir toutes les actualités',
        href: '/shop/collection.html',
        variant: 'link',
        icon_position: 'start',
        attr: {
          class: ['flex', 'm:hidden', 'mt-6']
        }
      } %}
    </div>
  </div>
</section>
