<div data-component="PasswordValidation" class="col-span-2 grid s:grid-cols-2 gap-x-3 gap-y-6">
  {% include '@components/field.twig' with {
    label: 'Mot de passe',
    name: 'password',
    required: true,
    input_attr: {
      'data-ref': 'password[]'
    }
  } only %}
  {% include '@components/field.twig' with {
    label: 'Confirmer le mot de passe',
    name: 'password_confirm',
    required: true,
    input_attr: {
      'data-ref': 'password[]'
    }
  } only %}

  <div class="hidden text-sm font-medium text-gray" data-ref="message">
    <strong>Votre mot de passe doit contenir les éléments suivants :</strong>
    <p data-ref="letter">Au moins une lettre en minuscule</p>
    <p data-ref="capital">Au moins une lettre en majuscule</p>
    <p data-ref="number">Au moins un chiffre</p>
    <p data-ref="length">Au moins 8 caractères</p>
    <p data-ref="special">Au moins un caractère spécial</p>
    <p data-ref="match">Les mots de passe ne correspondent pas</p>
  </div>
</div>
