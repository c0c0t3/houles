{% set type = type|default('text') %}
{% set id = id|default(name ~ '-' ~ random()) %}
{% set required = required|default(false) %}

{% set inline = inline|default(false) %}

{% set attributes =
  merge_html_attributes(
    attr ?? null,
    {},
    {
      class: 'flex flex-col items-start relative'
        ~ (not inline ? ' flex-col' : ' m:flex-row m:items-center is-inline')
        ~ ' gap-2 s:gap-3'
        ~ (tooltip_modal ? ' has-tooltip-modal' : ' has-not-tooltip-modal')
    }
  )
%}

{% set label_attributes =
  merge_html_attributes(
    label_attr ?? null,
    {},
    {
      for: id,
      class: 'text-sm leading-none font-medium uppercase text-purple'
        ~ (inline ? ' w-full pr-8 s:pr-0 s:w-1/3 shrink-0' : '')
    }
  )
%}

{% set input_attributes =
  merge_html_attributes(
    input_attr ?? null,
    {},
    {
      name: name,
      id: id,
      required: required,
      value: value|default(false),
      placeholder: placeholder|default(false),
      class: 'block w-full font-sans font-medium text-sm leading-6 border border-purple rounded-lg bg-transparent text-purple  py-4 px-6 focus-visible:bg-white appearance-none'
        ~ (tooltip_modal ? ' -mr-2' : '')
    }
  )
%}

<div {{ html_attributes(attributes) }}>
  {% block label %}
    {% if tooltip_content %}
      <div class="relative w-fit flex items-center gap-2">
        <label {{ html_attributes(label_attributes) }}>{{ label ~ (required ? ' *' : '') }}</label>
        {% embed '@components/ui/basic-tooltip.twig'
          with {
            tooltip_content: tooltip_content
          }
        %}

        {% endembed %}
      </div>
    {% else %}
      <label {{ html_attributes(label_attributes) }}>{{ label ~ (required ? ' *' : '') }}</label>
      {% if tooltip_modal %}
        <svg class="absolute right-0 s:relative size-6 s:size-10 -translate-y-1.5 s:translate-y-0"
          data-component="Action"
          data-option-target="Modal(#tooltip-{{ id }})"
          data-option-effect="target.open()"
          class="w-4 h-4 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor">
          <path fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
            clip-rule="evenodd" />
        </svg>
      {% endif %}
    {% endif %}
  {% endblock %}
  {% if type == 'textarea' %}
    <textarea {{ html_attributes(input_attributes) }}></textarea>
  {% elseif type == 'password' %}
    <div data-component="Password" class="relative w-full">
      <div data-ref="passwordToggle" class="absolute inset-y-0 right-0 flex items-center px-2">
        <?xml version="1.0" encoding="utf-8"?><!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
        <svg data-ref="icon-eye-encrypted"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2L22 22"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path d="M6.71277 6.7226C3.66479 8.79527 2 12 2 12C2 12 5.63636 19 12 19C14.0503 19 15.8174 18.2734 17.2711 17.2884M11 5.05822C11.3254 5.02013 11.6588 5 12 5C18.3636 5 22 12 22 12C22 12 21.3082 13.3317 20 14.8335"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path d="M14 14.2362C13.4692 14.7112 12.7684 15.0001 12 15.0001C10.3431 15.0001 9 13.657 9 12.0001C9 11.1764 9.33193 10.4303 9.86932 9.88818"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>

        <svg data-ref="icon-eye-unencrypted"
          class="size-4 hidden"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path d="M1 12C1 12 5 4 12 4C19 4 23 12 23 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path d="M1 12C1 12 5 20 12 20C19 20 23 12 23 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <circle cx="12"
            cy="12"
            r="3"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </div>
      <input type="password" data-ref="passwordInput" {{ html_attributes(input_attributes) }} />
    </div>
  {% else %}
    <input type="{{ type }}" {{ html_attributes(input_attributes) }} />
  {% endif %}
  {% if tooltip_modal %}
    {% embed '@components/modal/modal-tooltip.twig'
      with {
        attr: {
          id: 'tooltip-' ~ id
        }
      }
    %}
      {% block content %}
        {{ tooltip_modal }}
      {% endblock %}
    {% endembed %}
  {% endif %}
</div>
