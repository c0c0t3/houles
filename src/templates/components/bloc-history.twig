<div data-component="Slider"
  data-option-mode="left"
  data-option-fit-bounds=""
  data-option-contain=""
  class="relative py-12 l:py-20 bg-purple-light l:bg-transparent text-white max-w-screen overflow-hidden"
  role="group"
  aria-roledescription="carousel">
  <div class="container relative">
    <div class="history__bg hidden l:block absolute -inset-y-20 right-40 w-screen bg-purple-light"></div>
    <div class="relative l:space-y-10 space-y-6">
      <h2 class="l:text-7xl s:text-4xl text-3xl font-serif font-light uppercase max-w-xl leading-xtight l:absolute l:top-0 l:left-0 l:translate-y-8">
        Une histoire familiale
      </h2>
      <div data-ref="wrapper"
        data-option-active-breakpoints="xxs xs s m"
        data-component="SliderDrag"
        tabindex="0"
        class="space-x-12 select-none flex flex-nowrap overflow-hidden w-full">
        {% for year in years %}
          {% set is_active = loop.first ? 'is-active' : '' %}
          <div data-component="SliderItem"
            class="history__slide l:mb-20 w-full shrink-0 flex flex-col-reverse items-start l:flex-row justify-between l:items-end gap-10 {{
            is_active
            }}">
            <div class="w-full max-w-md space-y-4 l:space-y-6 opacity-0 parent-is-active:opacity-100 transition-all duration-500 delay-0 parent-is-active:delay-200 ease-in-out">
              <h3 class="history__slide-title font-serif text-2xl l:text-4xl">{{ year.year }}</h3>
              <p class="history__slide-content whitespace-normal l:pr-8">{{ year.content }}</p>
            </div>
            <div class="l:w-1/2 w-full flex items-end gap-8 flex-row-reverse">
              <img class="w-full aspect-square object-cover l:opacity-0 l:translate-y-8 parent-is-active:translate-y-0 duration-0 parent-is-active:opacity-100 transition-all parent-is-active:duration-1000 delay-0 parent-is-active:delay-1000 ease-in-outout"
                src="{{ year.image_principale.src }}"
                alt="{{ year.image_principale.alt }}"
                width="{{ year.image_principale.width }}"
                height="{{ year.image_principale.height }}" />
              <img class="hidden s:block s:w-1/3 l:w-48 aspect-[197/264] object-cover opacity-0 translate-y-8 parent-is-active:translate-y-0 parent-is-active:opacity-100 transition-all duration-0 parent-is-active:duration-1000 delay-0 parent-is-active:delay-500 ease-in-out"
                src="{{ year.image_secondaire.src }}"
                alt="{{ year.image_secondaire.alt }}"
                width="{{ year.image_secondaire.width }}"
                height="{{ year.image_secondaire.height }}" />
            </div>
          </div>
        {% endfor %}
      </div>
      <div data-component="SliderDots"
        data-option-enter-to="is-active"
        data-option-enter-keep=""
        class="space-x-8 pb-4 mb-4 relative flex flex-nowrap overflow-auto">
        {% for year in years %}
          <button class="opacity-50 is-active:opacity-100 shrink-0 text-xs" data-ref="dots[]">
            {{ year.year }}
          </button>
        {% endfor %}
      </div>
      <div class="l:pr-40">
        <div data-component="SliderProgress"
          class="w-full rounded bg-gradient-to-r from-white/50 to-transparent overflow-hidden h-px relative">
          <div class="h-px bg-white w-full rounded origin-left duration-1000 transition ease-in-out relative"
            data-ref="progress"
            style="transform: translate3d({{ progress_width }}% 0px, 0px);">
            <div style="width: 2rem"
              class="absolute bg-white translate-x-full right-0 top-0 h-full"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
