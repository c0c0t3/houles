{% set collections = [
  {
    title: 'Asara',
    link: '/shop/collection.html',
    src: '/assets/card-collection.jpg',
    categoryTitle: 'Passementerie'
  },
  {
    title: 'THE MICHAEL AIDUSS COLLECTION',
    link: '/shop/collection.html',
    src: '/assets/card-collection-1.jpg',
    categoryTitle: 'Tringlerie'
  },
  {
    title: 'Acea',
    link: '/shop/collection.html',
    src: '/assets/card-collection-2.jpg',
    categoryTitle: 'Tringlerie'
  },
  {
    title: 'Auro',
    link: '/shop/collection.html',
    src: '/assets/card-collection-3.jpg',
    categoryTitle: 'Tissus'
  },
  {
    title: 'Fin de séries',
    link: '/shop/collection.html',
    src: '/assets/card-collection-4.jpg',
    categoryTitle: 'Fin de séries'
  }
] %}

<section data-component="Slider"
  data-option-mode="left"
  data-option-fit-bounds
  data-option-contain
  class="overflow-hidden max-w-screen py-10 m:py-16">
  <div class="container">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-3xl s:text-4xl m:text-6xl font-serif text-gray font-light uppercase">
        Nos Collections
      </h2>
      <div class="hidden m:block">
        {% include '@components/button.twig' with {
          label: 'Voir tous nos produits',
          href: '/shop/collection.html',
          variant: 'link',
          icon_position: 'start'
        } %}
      </div>
    </div>
    <div data-component="SliderDrag"
      data-ref="wrapper"
      tabindex="0"
      class="homepage-hero relative z-1 whitespace-nowrap select-none h-full flex flex-row flex-nowrap [&>*]:cursor-grab gap-2 m:gap-8">
      {% for collection in collections %}
        {% include '@components/ui/card/card-collection.twig' with {
          title: collection.title,
          categoryTitle: collection.categoryTitle,
          src: collection.src,
          link: collection.link
        } %}
      {% endfor %}
    </div>
    <div class="flex items-center justify-between mt-10 gap-8">
      <div class="buttons hidden m:flex items-center gap-4">
        <button title="Prev"
          type="button"
          data-component="SliderBtn"
          data-option-prev
          class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
          {% include '@ui/Icon/Icon.twig' with {
            name: 'arrow-line-desktop',
            attr: {
              class: ['rotate-180', 'w-14', 'block']
            }
          } %}
        </button>
        <button title="Next"
          type="button"
          data-component="SliderBtn"
          data-option-next
          class="cursor-pointer transition disabled:cursor-not-allowed disabled:opacity-50 block text-purple py-2">
          {% include '@ui/Icon/Icon.twig' with {
            name: 'arrow-line-desktop',
            attr: {
              class: ['w-14', 'block']
            }
          } %}
        </button>
      </div>
      <div data-component="SliderProgress"
        class="w-full rounded bg-gradient-to-r from-gray/20 to-transparent overflow-hidden flex-1 h-px relative">
        <div class="h-px bg-purple rounded origin-left duration-1000 transition ease-in-out before:content-[''] before:absolute before:w-1/4 before:h-full before:bg-purple before:translate-x-full before:right-0 before:top-0"
          data-ref="progress"></div>
      </div>
    </div>
    <div class="flex items-center justify-center m:hidden">
      {% include '@components/button.twig' with {
        label: 'Voir tous nos produits',
        href: '/shop/collection.html',
        variant: 'link',
        icon_position: 'start',
        attr: {
          class: ['flex', 'm:hidden', 'mt-6']
        }
      } %}
    </div>
  </div>
</section>
